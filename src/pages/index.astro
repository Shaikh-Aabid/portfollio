---
import data from '../../shared/data.json';
import { Image } from 'astro:assets';
import avatar from '../../public/avatar.png';
import chooseAppLogo from '../../public/project-logos/chooseapp.png';
import walkiesLogo from '../../public/project-logos/walkies.png';
import aadabLogo from '../../public/project-logos/aadab-logo.png';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import ProjectDirectory from '../components/ProjectDirectory.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const featured = ['ChooseApp','Walkies','Aadab'].map(name=>data.featuredProjects.find(p=>p.name===name)!);
const expertise = [
  {title:'Interfaces that feel right.',label:'01 / FRONTEND',text:'Responsive web experiences with clear interactions and a thoughtful approach to application state.',items:['Vue.js / Nuxt','React / Next.js','TypeScript','Tailwind CSS']},
  {title:'A solid foundation.',label:'02 / BACKEND & DATA',text:'APIs, application logic, and data models that connect the moving parts of a product.',items:['Laravel / PHP','Node.js / Express','SQL / NoSQL','GraphQL / REST']},
  {title:'Beyond the browser.',label:'03 / MOBILE & DELIVERY',text:'Cross-platform mobile applications and the infrastructure to get them into people’s hands.',items:['Flutter / Dart','Firebase','Docker / DevOps','CI/CD']}
];
---
<PortfolioLayout>
  <section class="container hero" aria-labelledby="intro-title">
    <div class="hero-top"><p class="eyebrow"><span class="live-dot"></span> OPEN TO SELECT PROJECTS</p><p class="mono">NAVI MUMBAI, INDIA <span class="orange">↗</span></p></div>
    <div class="hero-heading"><h1 id="intro-title">Thoughtful code.<br/><span>Useful products.</span></h1><div class="hero-seal" aria-hidden="true"><svg viewBox="0 0 100 100"><path d="M50 9v82M9 50h82M21 21l58 58M21 79l58-58"/></svg><span>IDEA → INTERFACE → IMPACT</span></div></div>
    <div class="hero-bottom"><div class="hero-person"><Image src={avatar} widths={[52,104]} sizes="52px" width={64} height={64} format="webp" alt={`Illustrated portrait of ${data.name}`} loading="eager"/><div><strong>I’m {data.name}.</strong><span>Full-stack & mobile developer</span></div></div><p>I’m Aabid Hussain Shaikh, a full-stack and mobile developer in Navi Mumbai, India. {data.years}+ years building web applications, mobile apps, and APIs.</p><a class="button primary" href="#work">Explore my work <span aria-hidden="true">↓</span></a></div>
    <div class="hero-banner" aria-hidden="true"><span>BUILD</span><div class="banner-symbol">↗</div><span>WITH<br/><em>INTENT.</em></span><span class="banner-note">FRONTEND<br/>BACKEND<br/>MOBILE<br/><b>ALL CONNECTED.</b></span><div class="banner-lines"><i></i><i></i><i></i><i></i><i></i></div></div>
    <div class="hero-caption mono"><span>01 / A DEVELOPER WITH A PRODUCT MINDSET</span><span>SCROLL TO EXPLORE ↓</span></div>
  </section>
  <section class="container section" id="work" aria-labelledby="work-title">
    <div class="section-top"><p class="eyebrow">01 — SELECTED WORK</p><span class="mono">WEB / MOBILE / SYSTEMS</span></div>
    <div class="section-heading"><h2 id="work-title">Different challenges.<br/><span>The same care.</span></h2><p>A few products from my portfolio. Explore the platforms, then browse the complete collection below.</p></div>
    <div class="featured-grid">{featured.map((project,index)=><article class={`feature-card feature-${index}`}>
      <div class={`feature-art project-brand-art brand-${index}`}><span class="art-label">{project.category}</span><div class="project-logo-stage">{index===0?<Image class="project-logo chooseapp-logo" src={chooseAppLogo} widths={[160,320]} sizes="160px" width={160} format="webp" alt="ChooseApp logo" loading="lazy"/>:index===1?<Image class="project-logo walkies-logo" src={walkiesLogo} widths={[300,600]} sizes="(max-width: 760px) 75vw, 300px" width={300} format="webp" alt="Walkies — Let’s Roll logo" loading="lazy"/>:<Image class="project-logo aadab-logo" src={aadabLogo} widths={[160,320]} sizes="160px" width={160} format="webp" alt="Aadab logo" loading="lazy"/>}</div><span class="art-foot">{project.platforms.join(' / ')}<span>0{index+1}</span></span></div>
      <div class="feature-info"><h3>{project.name}</h3><p>{project.description}</p><div class="feature-links">{project.links.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div></div>
    </article>)}</div>
  </section>
  <section class="archive-section" id="projects" aria-labelledby="archive-title"><div class="container"><div class="section-heading compact"><div><p class="eyebrow">THE FULL COLLECTION</p><h2 id="archive-title">The complete collection<span class="orange">.</span></h2></div><a class="text-link" href={`${base}gallery/`}>Open project directory ↗</a></div><ProjectDirectory/></div></section>
  <section class="container section about" id="about" aria-labelledby="about-title"><div class="about-visual"><div class="about-portrait"><Image src={avatar} widths={[320,480,720]} sizes="(max-width: 760px) 85vw, 440px" format="webp" alt="Illustrated portrait of Aabid Hussain Shaikh" loading="lazy"/><span class="portrait-label mono">AABID HUSSAIN SHAIKH<br/>DEVELOPER / BUILDER / CURIOUS HUMAN</span></div><div class="experience-stamp"><strong>{data.years}+</strong><span>YEARS OF<br/>BUILDING THINGS</span></div></div><div class="about-copy"><p class="eyebrow">02 — THE PERSON BEHIND THE CODE</p><h2 id="about-title">Backend roots.<br/><span>Product instincts.</span></h2><p class="lede">I like understanding how the whole thing works. Then making it work better.</p><p>{data.aboutText}</p><p>My favourite part is connecting the pieces: the interface someone sees, the API they never notice, and the data that keeps it all moving.</p><a class="text-link" href={`${base}Aabid-Hussain-Shaikh-Resume.pdf`} target="_blank" rel="noopener noreferrer">Read my résumé <span aria-hidden="true">↗</span></a><div class="about-facts"><span>BASED IN<br/><strong>Navi Mumbai, India</strong></span><span>FOCUS<br/><strong>Web · Mobile · APIs</strong></span></div></div></section>
  <section class="expertise-section" id="expertise" aria-labelledby="expertise-title"><div class="container section"><div class="section-top"><p class="eyebrow">03 — WHAT I BRING TO THE BUILD</p><span class="mono">FROM FIRST COMMIT TO DELIVERY</span></div><div class="section-heading"><h2 id="expertise-title">Across the stack.<br/><span>Down to the details.</span></h2></div><div class="expertise-grid">{expertise.map(group=><article class="expertise-card"><p class="mono orange">{group.label}</p><h3>{group.title}</h3><p>{group.text}</p><ul>{group.items.map(item=><li><span>{item}</span><small>{data.skills[item]}</small></li>)}</ul></article>)}</div></div></section>
  <section class="container contact section" id="contact" aria-labelledby="contact-title"><p class="eyebrow"><span class="live-dot"></span> GOOD PRODUCTS START WITH A CONVERSATION</p><h2 id="contact-title">Have a good idea?<br/><a href={`mailto:${data.author.email}`}>Let’s build it.<span aria-hidden="true">↗</span></a></h2><div class="contact-bottom"><p>Tell me what you’re working on.<br/>I’d love to hear where you want to take it.</p><div><a href={`mailto:${data.author.email}`}>{data.author.email}</a><a href={`tel:${data.author.phone.replaceAll(' ','')}`}>{data.author.phone}</a></div></div></section>
</PortfolioLayout>
