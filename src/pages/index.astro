---
import data from '../../shared/data.json' assert { type: 'json' };
const projects = data.featuredProjects;
const siteUrl = 'https://shaikh-aabid.github.io/portfollio/';
const pageDescription = `${data.name} is a Navi Mumbai-based full-stack and mobile developer with ${data.years}+ years of experience building web applications, mobile apps, and APIs with Laravel, Vue, React, and Flutter.`;
const personSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: data.name,
      givenName: 'Aabid Hussain',
      familyName: 'Shaikh',
      jobTitle: data.title,
      description: data.bio,
      url: siteUrl,
      email: `mailto:${data.author.email}`,
      telephone: data.author.phone,
      address: { '@type': 'PostalAddress', addressLocality: 'Navi Mumbai', addressCountry: 'IN' },
      knowsAbout: ['Full-stack development', 'Mobile app development', 'Laravel', 'PHP', 'Vue.js', 'React', 'Flutter', 'API development', 'Database design'],
      sameAs: [data.author.github, data.author.linkedin],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'Who is Aabid Hussain Shaikh?', acceptedAnswer: { '@type': 'Answer', text: 'Aabid Hussain Shaikh is a Navi Mumbai-based full-stack and mobile developer with 7+ years of experience building web applications, mobile apps, and APIs.' } },
        { '@type': 'Question', name: 'What does Aabid Hussain Shaikh build?', acceptedAnswer: { '@type': 'Answer', text: 'Aabid builds full-stack web products, cross-platform mobile applications, APIs, and the backend systems that support them.' } },
        { '@type': 'Question', name: 'How can I contact Aabid Hussain Shaikh?', acceptedAnswer: { '@type': 'Answer', text: `Email ${data.author.email} or call ${data.author.phone}.` } },
      ],
    },
  ],
};
const stackGroups = [
  { name: 'Frontend', items: ['Vue.js / Nuxt', 'React / Next.js', 'TypeScript', 'Tailwind CSS'], accent: 'cyan' },
  { name: 'Backend & APIs', items: ['Laravel / PHP', 'Node.js / Express', 'GraphQL / REST'], accent: 'violet' },
  { name: 'Mobile & cloud', items: ['Flutter / Dart', 'Firebase'], accent: 'amber' },
  { name: 'Data & delivery', items: ['SQL / NoSQL', 'Docker / DevOps', 'CI/CD'], accent: 'green' },
];
const flow = (project) => project.stack.map((item, index) => ({ name: item, index }));
---
<!doctype html>
<html lang="en">
