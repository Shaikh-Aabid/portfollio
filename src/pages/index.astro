    <meta name="description" content={pageDescription} />
    <meta name="author" content={data.name} />
    <meta name="keywords" content="Aabid Hussain Shaikh, full-stack developer, mobile app developer, Laravel developer, Vue.js developer, React developer, Flutter developer, Navi Mumbai India" />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={`${data.name} — Full-stack & mobile developer`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="profile:first_name" content="Aabid Hussain" />
    <meta property="profile:last_name" content="Shaikh" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${data.name} — Full-stack & mobile developer`} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="theme-color" content="#0e1115" />
    <title>{data.name} — Full-stack product developer</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <link rel="icon" type="image/png" href="/portfollio/avatar.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root{--bg:#0e1115;--panel:#151a20;--panel2:#1a2027;--line:#2c343c;--ink:#f1f4f5;--muted:#9aa6ad;--soft:#6d7981;--cyan:#55e7d0;--violet:#a58bff;--amber:#ffbd66;--green:#b5ed75;--mono:'DM Mono',monospace;--sans:'Space Grotesk',sans-serif;color:var(--ink);background:var(--bg);font-family:var(--sans);font-synthesis:none;scroll-behavior:smooth}*{box-sizing:border-box}body{margin:0;min-width:320px;overflow-x:hidden;color:var(--ink);background:radial-gradient(ellipse at 55% -15%,#21313a 0,transparent 39%),var(--bg)}a{color:inherit;text-decoration:none}button{font:inherit}.wrap{width:min(1160px,calc(100% - 48px));margin:auto}.mono{font-family:var(--mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase}.topbar{position:sticky;top:0;z-index:20;border-bottom:1px solid #ffffff14;background:#0e1115e8;backdrop-filter:blur(16px)}.nav{height:66px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:-.04em}.brand-mark{width:30px;height:30px;display:grid;place-items:center;color:var(--bg);background:var(--cyan);font-size:11px}.brand-label{font-size:12px}.brand-label small{display:block;margin-top:2px;color:var(--soft);font:8px var(--mono);letter-spacing:.08em}.nav-links{display:flex;align-items:center;gap:25px;color:#c5cdd1;font:9px var(--mono);text-transform:uppercase}.nav-links a:hover{color:var(--cyan)}.nav-contact{padding:10px 13px;border:1px solid #ffffff36;color:var(--ink)!important}.nav-contact:hover{border-color:var(--cyan)}
      .hero{padding:83px 0 0}.eyebrow{display:flex;align-items:center;gap:10px;color:var(--cyan)}.eyebrow::before{content:'';width:23px;height:1px;background:currentColor}.hero h1{max-width:1030px;margin:22px 0 19px;font-size:clamp(52px,8.8vw,104px);font-weight:600;line-height:.9;letter-spacing:-.09em}.hero h1 .accent{color:var(--cyan)}.hero-copy{display:flex;align-items:end;justify-content:space-between;gap:30px}.hero-copy p{max-width:610px;margin:0;color:#b8c0c4;font-size:14px;line-height:1.8}.hero-actions{display:flex;gap:10px;flex:none}.button{min-height:43px;display:inline-flex;align-items:center;gap:11px;padding:0 14px;border:1px solid #ffffff33;color:var(--ink);font-size:10px;font-weight:700;transition:.2s}.button:hover{transform:translateY(-2px);border-color:var(--cyan)}.button-primary{border-color:var(--cyan);color:#091412;background:var(--cyan)}
      .source-panel{position:relative;margin-top:39px;border:1px solid #38444c;background:#11171c;box-shadow:0 18px 50px #0003}.source-top{height:39px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;border-bottom:1px solid #303940;color:var(--muted);font:8px var(--mono);text-transform:uppercase}.window-dots{display:flex;gap:5px}.window-dots i{width:6px;height:6px;border-radius:50%;background:#ff725d}.window-dots i:nth-child(2){background:#e9c25b}.window-dots i:nth-child(3){background:#6cc68b}.source-body{display:grid;grid-template-columns:45px 1fr 285px;min-height:198px}.line-numbers{padding:18px 0;border-right:1px solid #293139;color:#59646b;text-align:center;font:9px/1.95 var(--mono)}.code{padding:17px 20px;overflow:hidden;color:#dce3e6;font:11px/1.95 var(--mono);white-space:pre}.code .kw{color:var(--violet)}.code .key{color:var(--cyan)}.code .str{color:var(--green)}.code .comment{color:#76828a}.code-cursor{display:inline-block;width:6px;height:13px;margin-left:4px;vertical-align:-2px;background:var(--cyan);animation:blink 1s steps(2,start) infinite}@keyframes blink{to{visibility:hidden}}.source-aside{display:flex;flex-direction:column;justify-content:space-between;padding:16px;border-left:1px solid #293139;background:#131a20}.aside-label{color:var(--soft)}.aside-profile{display:flex;align-items:center;gap:11px;margin-top:12px}.aside-profile img{width:43px;height:43px;object-fit:cover;border:1px solid #49545a;border-radius:50%}.aside-profile strong{display:block;font-size:11px}.aside-profile span{display:block;margin-top:3px;color:var(--muted);font:8px var(--mono)}.aside-status{display:flex;align-items:center;gap:8px;padding-top:12px;border-top:1px solid #2c343c;color:#aeb8bd;font:8px var(--mono)}.status-light{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 10px #b5ed75}
      .pipeline{display:grid;grid-template-columns:repeat(4,1fr);margin-top:18px;border:1px solid var(--line);background:#11161b}.pipe-step{position:relative;min-height:89px;display:flex;align-items:center;gap:12px;padding:14px 18px;border-right:1px solid var(--line)}.pipe-step:last-child{border:0}.pipe-step:not(:last-child)::after{content:'→';position:absolute;right:-8px;z-index:2;padding:2px 4px;color:var(--cyan);background:#11161b;font:12px var(--mono)}.pipe-index{color:var(--cyan);font:8px var(--mono)}.pipe-step strong{display:block;font-size:11px}.pipe-step small{display:block;margin-top:4px;color:var(--muted);font:8px var(--mono)}
      .section{padding:94px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:27px}.section-kicker{color:var(--cyan)}.section-head h2{margin:9px 0 0;font-size:clamp(36px,5.5vw,62px);line-height:.94;letter-spacing:-.075em}.section-head p{max-width:390px;margin:0;color:#aab4b9;font-size:11px;line-height:1.75}.project-list{display:grid;gap:12px}.project{display:grid;grid-template-columns:1.04fr .96fr;min-height:245px;border:1px solid var(--line);background:var(--panel);transition:border-color .2s,transform .2s}.project:hover{transform:translateY(-2px);border-color:#55656b}.project-copy{display:flex;flex-direction:column;justify-content:center;padding:25px 30px}.project-meta{display:flex;justify-content:space-between;gap:12px;color:var(--cyan)}.project h3{margin:12px 0 8px;font-size:clamp(24px,3.1vw,37px);line-height:1;letter-spacing:-.07em}.project-copy p{max-width:470px;margin:0;color:#aeb7bc;font-size:11px;line-height:1.7}.project-bottom{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:18px;padding-top:12px;border-top:1px solid var(--line)}.tags{display:flex;flex-wrap:wrap;gap:5px}.tags span{padding:5px 7px;border:1px solid #3a454b;color:#c3ccd0;font:8px var(--mono)}.contact-link{color:var(--cyan);font:8px var(--mono);text-transform:uppercase;white-space:nowrap}.architecture{position:relative;display:flex;flex-direction:column;justify-content:center;gap:10px;padding:25px;border-left:1px solid var(--line);background:#11171c}.arch-label{margin-bottom:5px;color:var(--soft)}.arch-path{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.arch-node{padding:7px 8px;border:1px solid #48535a;background:#1b2329;color:#dbe1e3;font:8px var(--mono)}.arch-node:first-child{border-color:#55e7d070;color:var(--cyan)}.arch-arrow{color:#748088;font:11px var(--mono)}.arch-foot{margin-top:4px;color:#7f8a91;font:8px var(--mono)}.project:nth-child(2) .arch-node:first-child{border-color:#a58bff80;color:#c4b9ff}.project:nth-child(3) .arch-node:first-child{border-color:#ffbd6680;color:#ffd290}.project:nth-child(4) .arch-node:first-child{border-color:#b5ed7580;color:#cef8a0}
      .craft-section{display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;align-items:start;padding:60px 0 80px;border-top:1px solid var(--line)}.craft-copy h2{max-width:390px;margin:10px 0;font-size:clamp(35px,4.5vw,54px);line-height:.94;letter-spacing:-.075em}.craft-copy p{max-width:390px;color:#aab4b9;font-size:11px;line-height:1.8}.skills-grid{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);border-left:1px solid var(--line)}.skill{display:flex;justify-content:space-between;gap:12px;padding:14px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:#12171c}.skill span{font-size:10px}.skill small{color:#88949a;font:8px var(--mono)}.about{display:grid;grid-template-columns:180px 1fr;gap:35px;padding:38px 0 50px;border-top:1px solid var(--line)}.about-portrait{width:132px;height:132px;overflow:hidden;border:1px solid #465159;border-radius:50%;background:#20282e}.about-portrait img{width:100%;height:100%;object-fit:cover}.about-copy h2{margin:8px 0;font-size:clamp(27px,4vw,42px);line-height:1;letter-spacing:-.07em}.about-copy p{max-width:730px;color:#aab4b9;font-size:11px;line-height:1.8}.contact{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:24px 0 20px;padding:27px 30px;border:1px solid #55e7d057;background:linear-gradient(110deg,#14211f,#14191c)}.contact h2{max-width:700px;margin:8px 0;font-size:clamp(32px,5.4vw,62px);line-height:.92;letter-spacing:-.08em}.contact p{margin:0;color:#acb7ba;font-size:10px}.contact .button{white-space:nowrap}.footer{display:flex;justify-content:space-between;gap:18px;padding:5px 0 25px;color:#87939a;font:8px var(--mono);text-transform:uppercase}.footer a:hover{color:var(--cyan)}.footer-links{display:flex;gap:16px}
      .source-tabs{display:flex;align-items:center;gap:6px;padding:9px 13px;border-bottom:1px solid #293139;background:#131a20}.source-tab{padding:6px 9px;border:1px solid transparent;background:transparent;color:#8e9aa1;font:8px var(--mono);text-transform:uppercase;cursor:pointer;transition:.2s}.source-tab:hover,.source-tab[aria-selected="true"]{border-color:#55e7d050;background:#55e7d012;color:var(--cyan)}.code-view[hidden]{display:none}.code{transition:opacity .18s}.filter-bar{display:flex;gap:7px;margin:-8px 0 17px}.filter-button{padding:8px 11px;border:1px solid var(--line);background:transparent;color:#aab4b9;font:8px var(--mono);text-transform:uppercase;cursor:pointer;transition:.2s}.filter-button:hover,.filter-button[aria-pressed="true"]{border-color:var(--cyan);background:#55e7d012;color:var(--cyan)}.project[hidden]{display:none}.project{animation:project-in .42s both}.project:nth-child(2){animation-delay:.05s}.project:nth-child(3){animation-delay:.1s}.project:nth-child(4){animation-delay:.15s}@keyframes project-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}.pipe-step,.skill,.arch-node{transition:transform .22s,border-color .22s,background .22s,box-shadow .22s}.pipe-step:hover{z-index:1;transform:translateY(-3px);background:#18211f}.skill:hover{background:#18211f}.skill:hover span{color:var(--cyan)}.arch-node:hover{transform:translateY(-2px);border-color:var(--cyan);background:#1c2a2a;box-shadow:0 5px 18px #55e7d018}.reveal{opacity:0;transform:translateY(18px);transition:opacity .65s ease,transform .65s cubic-bezier(.2,.7,.2,1)}.reveal.is-visible{opacity:1;transform:none}.source-panel::after{content:'';position:absolute;inset:0 auto 0 -1px;width:2px;background:var(--cyan);box-shadow:0 0 12px #55e7d0;transform:scaleY(0);transform-origin:top;transition:transform .7s}.source-panel:hover::after{transform:scaleY(1)}
      .craft-section[id="stack"]{gap:42px;padding:58px 0 66px;scroll-margin-top:82px}.craft-section[id="stack"] .skills-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;border:0}.stack-group{padding:13px;border:1px solid #ffffff20;background:linear-gradient(145deg,#161d22,#11171b);transition:transform .2s,border-color .2s}.stack-group:hover{transform:translateY(-2px);border-color:#55e7d070}.stack-group-head{display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;border-bottom:1px solid #ffffff1c;color:var(--cyan)}.stack-group.violet .stack-group-head{color:var(--violet)}.stack-group.amber .stack-group-head{color:var(--amber)}.stack-group.green .stack-group-head{color:var(--green)}.stack-group ul{display:grid;gap:0;margin:4px 0 0;padding:0;list-style:none}.stack-group li{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid #ffffff12;color:#e2e7e9;font-size:9px}.stack-group li:last-child{border-bottom:0}.stack-group li small{flex:none;color:#8d9a9f;font:8px var(--mono)}.about{padding-bottom:28px}.contact{margin:12px auto 20px}.contact-details{margin-top:12px;color:#bdc6c9;font:10px var(--mono);font-style:normal}.contact-details a:hover{color:var(--cyan)}.faq{padding:35px 0 46px;border-top:1px solid var(--line)}.faq h2{margin:8px 0 18px;font-size:clamp(27px,4vw,42px);letter-spacing:-.06em}.faq-list{border-top:1px solid var(--line)}.faq-list details{padding:14px 2px;border-bottom:1px solid var(--line)}.faq-list summary{color:#e8edef;font-size:12px;font-weight:600;cursor:pointer}.faq-list p{max-width:760px;margin:10px 0 0;color:#aab4b9;font-size:11px;line-height:1.7}.footer{align-items:center;border-top:1px solid var(--line);padding:18px 0 27px;color:#a0abb0;font:9px/1.6 var(--mono)}.footer-links{flex-wrap:wrap;gap:10px 20px}.footer-links a{padding:4px 0}
      .portfolio-loader[hidden]{display:none}.portfolio-loader{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:24px;background:radial-gradient(ellipse at 50% 45%,#1a2a2c 0,transparent 42%),var(--bg);opacity:1;visibility:visible;transition:opacity .35s ease,visibility .35s ease}.portfolio-loader.is-done{opacity:0;visibility:hidden;pointer-events:none}.loader-card{width:min(540px,100%);padding:25px;border:1px solid #55e7d052;background:#11171bf2;box-shadow:0 25px 80px #0008;opacity:0;transform:translateY(10px)}.portfolio-loader.is-active .loader-card{opacity:1;transform:none;transition:opacity .32s ease,transform .32s ease}.loader-top,.loader-bottom{display:flex;justify-content:space-between;gap:15px;color:#89969c;font:8px var(--mono);letter-spacing:.08em;text-transform:uppercase}.loader-brand{display:flex;align-items:center;gap:9px;color:#dfe6e8}.loader-mark{width:25px;height:25px;display:grid;place-items:center;background:var(--cyan);color:var(--bg);font-weight:700}.loader-content{display:flex;align-items:center;gap:18px;margin:35px 0 27px}.loader-orbit{position:relative;width:58px;height:58px;flex:none;display:grid;place-items:center;border:1px solid #55e7d080;border-radius:50%;color:var(--cyan);font:12px var(--mono);animation:loader-orbit 5s linear infinite}.loader-orbit::before,.loader-orbit::after{content:'';position:absolute;width:7px;height:7px;border:1px solid var(--bg);border-radius:50%;background:var(--cyan)}.loader-orbit::before{top:-4px;left:24px}.loader-orbit::after{right:-3px;bottom:10px;background:var(--violet)}@keyframes loader-orbit{to{transform:rotate(360deg)}}.loader-kicker{display:block;margin-bottom:8px;color:var(--cyan);font:8px var(--mono);letter-spacing:.12em;text-transform:uppercase}.loader-title{display:block;font-size:clamp(23px,5vw,34px);line-height:1;letter-spacing:-.06em}.loader-title em{color:var(--cyan);font-style:normal}.loader-track{height:2px;overflow:hidden;margin-bottom:12px;background:#ffffff16}.loader-track i{display:block;width:100%;height:100%;background:linear-gradient(90deg,var(--cyan),var(--violet));transform:scaleX(0);transform-origin:left;animation:loader-progress .58s cubic-bezier(.3,.7,.3,1) forwards}@keyframes loader-progress{to{transform:scaleX(1)}}
      @media(max-width:850px){.hero-copy{display:block}.hero-actions{margin-top:19px}.source-body{grid-template-columns:38px 1fr 220px}.pipeline{grid-template-columns:repeat(2,1fr)}.pipe-step:nth-child(2){border-right:0}.pipe-step:nth-child(2)::after{display:none}.pipe-step:nth-child(-n+2){border-bottom:1px solid var(--line)}.craft-section{gap:32px}.footer{align-items:flex-start;flex-direction:column;gap:10px}}
      @media(max-width:620px){.wrap{width:calc(100% - 32px)}.nav{height:58px}.nav-links{gap:12px;font-size:8px}.nav-links a:first-child{display:none}.nav-contact{padding:8px}.hero{padding-top:58px}.hero h1{font-size:clamp(48px,14vw,76px)}.hero-copy p{font-size:12px}.hero-actions{flex-wrap:wrap}.source-panel{margin-top:27px}.source-body{grid-template-columns:30px 1fr}.line-numbers{font-size:8px}.code{padding:14px 11px;font-size:8px;line-height:1.9}.source-aside{grid-column:span 2;display:grid;grid-template-columns:1fr auto;gap:12px;padding:10px;border-top:1px solid #293139;border-left:0}.aside-profile{margin-top:7px}.aside-profile img{width:34px;height:34px}.aside-status{align-self:end;padding:0;border:0;font-size:7px}.pipeline{grid-template-columns:1fr 1fr;margin-top:12px}.pipe-step{min-height:75px;padding:10px}.pipe-step:nth-child(2){border-right:0}.pipe-step:nth-child(2)::after{display:none}.pipe-step:nth-child(3){border-bottom:0}.pipe-step:nth-child(4){border-bottom:0}.section{padding:66px 0}.section-head{display:block}.section-head p{margin-top:12px}.project{grid-template-columns:1fr}.architecture{order:2;min-height:150px;padding:18px;border-top:1px solid var(--line);border-left:0}.project-copy{padding:20px}.project h3{font-size:29px}.project-copy p{font-size:11px}.project-bottom{align-items:flex-start;flex-direction:column}.craft-section{grid-template-columns:1fr;gap:20px;padding:42px 0 55px}.craft-section[id="stack"]{gap:18px;padding:42px 0 50px}.craft-section[id="stack"] .skills-grid{grid-template-columns:1fr}.stack-group li{font-size:10px}.about{grid-template-columns:64px 1fr;gap:17px;padding:29px 0}.about-portrait{width:64px;height:64px}.about-copy h2{font-size:27px}.about-copy p{font-size:10px}.contact{align-items:flex-start;flex-direction:column;padding:24px 19px}.contact h2{font-size:39px}.footer{flex-direction:column}}
      @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
    </style>
  </head>
  <body>
    <div class="portfolio-loader" id="portfolio-loader" hidden role="status" aria-live="polite" aria-label="Loading Aabid’s portfolio"><div class="loader-card"><div class="loader-top"><span class="loader-brand"><i class="loader-mark">AS</i> AABID SHAIKH</span><span>Portfolio / 01</span></div><div class="loader-content"><span class="loader-orbit" aria-hidden="true">AS</span><div><span class="loader-kicker">Full-stack · Mobile · Product</span><strong class="loader-title">Connecting the <em>layers.</em></strong></div></div><div class="loader-track" aria-hidden="true"><i></i></div><div class="loader-bottom"><span>Web · API · Mobile</span><span>Building for the real world</span></div></div></div>
    <header class="topbar"><nav class="wrap nav"><a class="brand" href="#top"><span class="brand-mark">AS</span><span class="brand-label">AABID HUSSAIN SHAIKH<small>FULL STACK · MOBILE · NAVI MUMBAI</small></span></a><div class="nav-links"><a href="#work">Work</a><a href="#stack">Stack</a><a href="#about">About</a><a class="nav-contact" href={`mailto:${data.author.email}`}>Contact ↗</a></div></nav></header>
    <main id="top">
      <section class="wrap hero"><span class="eyebrow mono">Product-minded engineering · {data.years}+ years</span><h1>From the first interface<br />to the <span class="accent">last API call.</span></h1><div class="hero-copy"><p>I’m {data.name}, a Navi Mumbai-based full-stack and mobile developer with 7+ years of experience. I build web applications, mobile apps, and APIs, connecting product thinking with careful engineering across the whole system.</p><div class="hero-actions"><a class="button button-primary" href="#work">Explore my work ↓</a><a class="button" href={`mailto:${data.author.email}`}>Let’s talk ↗</a></div></div>
        <div class="source-panel"><div class="source-top"><span class="window-dots"><i></i><i></i><i></i></span><span id="source-filename">aabid.config.ts</span><span>PRODUCT / BUILD PROFILE</span></div><div class="source-tabs" role="tablist" aria-label="Explore my development stack"><button class="source-tab" type="button" role="tab" aria-selected="true" data-code-mode="web">Web</button><button class="source-tab" type="button" role="tab" aria-selected="false" data-code-mode="api">API</button><button class="source-tab" type="button" role="tab" aria-selected="false" data-code-mode="mobile">Mobile</button><span class="mono" style="margin-left:auto;color:#68757c">SELECT A LAYER ↗</span></div><div class="source-body"><div class="line-numbers" id="code-lines">01<br />02<br />03<br />04<br />05<br />06<br />07</div><div class="code" id="profile-code" role="tabpanel" aria-live="polite"><span class="kw">const</span> <span class="key">build</span> = &#123;<br />&nbsp; <span class="key">web</span>: [<span class="str">'Vue.js'</span>, <span class="str">'React'</span>],<br />&nbsp; <span class="key">backend</span>: [<span class="str">'Laravel'</span>, <span class="str">'Node.js'</span>],<br />&nbsp; <span class="key">mobile</span>: [<span class="str">'Flutter'</span>],<br />&nbsp; <span class="key">mindset</span>: <span class="str">'understand → build → improve'</span><br />&#125;;<span class="code-cursor"></span></div><aside class="source-aside"><div><span class="aside-label mono">Built by</span><div class="aside-profile"><img src="/portfollio/avatar.png" alt="Illustrated portrait of Aabid" /><div><strong>Aabid Hussain Shaikh</strong><span>NAVI MUMBAI, INDIA · WORKING WORLDWIDE</span></div></div></div><div class="aside-status"><i class="status-light"></i> OPEN TO SELECT PROJECTS</div></aside></div></div>
        <div class="pipeline" aria-label="Full-stack product workflow"><div class="pipe-step"><span class="pipe-index">01</span><div><strong>Experience</strong><small>Vue · React · Flutter</small></div></div><div class="pipe-step"><span class="pipe-index">02</span><div><strong>Application</strong><small>Laravel · Node.js</small></div></div><div class="pipe-step"><span class="pipe-index">03</span><div><strong>Data</strong><small>MySQL · Redis · Firebase</small></div></div><div class="pipe-step"><span class="pipe-index">04</span><div><strong>Delivery</strong><small>Build · deploy · improve</small></div></div></div>
      </section>
      <section class="wrap section" id="work"><div class="section-head"><div><span class="section-kicker mono">Selected work / systems in practice</span><h2>Products, layer by layer.</h2></div><p>Each project asks for a different combination of product interface, application logic, and dependable data flow.</p></div><div class="filter-bar" role="group" aria-label="Filter projects"><button class="filter-button" type="button" aria-pressed="true" data-project-filter="all">All projects</button><button class="filter-button" type="button" aria-pressed="false" data-project-filter="web">Web platforms</button><button class="filter-button" type="button" aria-pressed="false" data-project-filter="mobile">Mobile apps</button></div><div class="project-list">{projects.map((project,index)=><article class="project" data-project-type={project.type}><div class="project-copy"><div class="project-meta mono"><span>BUILD / 0{index+1}</span><span>{project.type==='mobile'?'MOBILE APP':'WEB PLATFORM'}</span></div><h3>{project.name}</h3><p>{project.description}</p><div class="project-bottom"><div class="tags">{project.stack.map((item)=><span>{item}</span>)}</div><a class="contact-link" href={`mailto:${data.author.email}?subject=Question%20about%20${encodeURIComponent(project.name)}`}>Discuss this build ↗</a></div></div><div class="architecture"><span class="arch-label mono">Stack path / 0{index+1}</span><div class="arch-path">{flow(project).map((item,i)=><><span class="arch-node">{item.name}</span>{i < project.stack.length - 1 ? <span class="arch-arrow">→</span> : null}</>)}</div><span class="arch-foot">{project.type==='mobile'?'APPLICATION → SERVICES → DATA':'INTERFACE → APPLICATION → DATA'}</span></div></article>)}</div></section>
      <section class="wrap craft-section" id="stack"><div class="craft-copy"><span class="section-kicker mono">My stack / used in real builds</span><h2>One toolkit. Every product layer.</h2><p>From polished interfaces to reliable APIs, mobile apps, data, and delivery. These are the tools I use across the full build.</p></div><div class="skills-grid">{stackGroups.map((group,index)=><article class={`stack-group ${group.accent}`}><div class="stack-group-head"><span class="mono">0{index+1} / {group.name}</span><span aria-hidden="true">↗</span></div><ul>{group.items.map((name)=><li><span>{name}</span><small>{data.skills[name]}</small></li>)}</ul></article>)}</div></section>
      <section class="wrap about" id="about"><div class="about-portrait"><img src="/portfollio/avatar.png" alt="Illustrated portrait of Aabid Hussain Shaikh" loading="lazy" /></div><div class="about-copy"><span class="section-kicker mono">About Aabid Hussain Shaikh</span><h2>Backend roots. Product mindset.</h2><p>{data.aboutText}</p><p>I enjoy moving between architecture and interface work: tracing a feature from its first user need to the database decisions and interaction details that make it feel complete.</p></div></section>
      <section class="wrap faq" aria-labelledby="faq-title"><span class="section-kicker mono">Quick answers</span><h2 id="faq-title">Working with Aabid</h2><div class="faq-list"><details><summary>Who is Aabid Hussain Shaikh?</summary><p>Aabid Hussain Shaikh is a Navi Mumbai-based full-stack and mobile developer with 7+ years of experience building web applications, mobile apps, and APIs.</p></details><details><summary>What does Aabid build?</summary><p>He builds full-stack web products, cross-platform mobile applications, APIs, and the backend systems that support them.</p></details><details><summary>How can I contact Aabid?</summary><p>Email <a href={`mailto:${data.author.email}`}>{data.author.email}</a> or call <a href={`tel:${data.author.phone.replaceAll(' ', '')}`}>{data.author.phone}</a>.</p></details></div></section>
      <section class="wrap contact" id="contact"><div><span class="section-kicker mono">Have something worth building?</span><h2>Let’s make the whole system work.</h2><p>Contact Aabid Hussain Shaikh about full-stack development, mobile applications, APIs, or your next digital product.</p><address class="contact-details"><a href={`mailto:${data.author.email}`}>{data.author.email}</a><span> · </span><a href={`tel:${data.author.phone.replaceAll(' ', '')}`}>{data.author.phone}</a></address></div><a class="button button-primary" href={`mailto:${data.author.email}`}>Email Aabid ↗</a></section>
    </main>
    <footer class="wrap footer"><span>© {new Date().getFullYear()} {data.name} · NAVI MUMBAI, INDIA</span><div class="footer-links"><a href={data.author.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={data.author.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="/portfollio/Aabid-Hussain-Shaikh-Resume.pdf" target="_blank" rel="noopener noreferrer">Resume ↗</a></div></footer>
    <script>
      const loader = document.querySelector('#portfolio-loader');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (loader && !reducedMotion) {
        loader.hidden = false;
        requestAnimationFrame(() => loader.classList.add('is-active'));
        window.setTimeout(() => {
          loader.classList.add('is-done');
          window.setTimeout(() => loader.remove(), 400);
        }, 620);
      } else loader?.remove();
      const codeModes = {
        web: { file: 'web.interface.tsx', lines: '01\\n02\\n03\\n04\\n05\\n06', html: `<span class="kw">const</span> <span class="key">interface</span> = &#123;<br />&nbsp; <span class="key">framework</span>: [<span class="str">'Vue.js'</span>, <span class="str">'React'</span>],<br />&nbsp; <span class="key">focus</span>: <span class="str">'clear, responsive UI'</span>,<br />&nbsp; <span class="key">state</span>: <span class="str">'simple and predictable'</span>,<br />&nbsp; <span class="key">output</span>: <span class="str">'a product people enjoy'</span><br />&#125;;<span class="code-cursor"></span>` },
        api: { file: 'api.services.ts', lines: '01\\n02\\n03\\n04\\n05\\n06', html: `<span class="kw">const</span> <span class="key">services</span> = &#123;<br />&nbsp; <span class="key">backend</span>: [<span class="str">'Laravel'</span>, <span class="str">'Node.js'</span>],<br />&nbsp; <span class="key">data</span>: [<span class="str">'MySQL'</span>, <span class="str">'Redis'</span>],<br />&nbsp; <span class="key">contracts</span>: <span class="str">'documented APIs'</span>,<br />&nbsp; <span class="key">goal</span>: <span class="str">'reliable by design'</span><br />&#125;;<span class="code-cursor"></span>` },
        mobile: { file: 'mobile.product.dart', lines: '01\\n02\\n03\\n04\\n05\\n06', html: `<span class="kw">const</span> <span class="key">mobile</span> = &#123;<br />&nbsp; <span class="key">framework</span>: <span class="str">'Flutter'</span>,<br />&nbsp; <span class="key">language</span>: <span class="str">'Dart'</span>,<br />&nbsp; <span class="key">backend</span>: <span class="str">'Firebase'</span>,<br />&nbsp; <span class="key">promise</span>: <span class="str">'one thoughtful experience'</span><br />&#125;;<span class="code-cursor"></span>` }
      };
      document.querySelectorAll('[data-code-mode]').forEach((tab) => tab.addEventListener('click', () => {
        const mode = codeModes[tab.dataset.codeMode];
        document.querySelectorAll('[data-code-mode]').forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
        document.querySelector('#source-filename').textContent = mode.file;
        document.querySelector('#code-lines').innerHTML = mode.lines.replaceAll('\\n', '<br />');
        document.querySelector('#profile-code').innerHTML = mode.html;
      }));
      document.querySelectorAll('[data-project-filter]').forEach((button) => button.addEventListener('click', () => {
        const filter = button.dataset.projectFilter;
        document.querySelectorAll('[data-project-filter]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        document.querySelectorAll('[data-project-type]').forEach((project) => { project.hidden = filter !== 'all' && project.dataset.projectType !== filter; });
      }));
      const revealTargets = document.querySelectorAll('.source-panel, .pipeline, .section-head, .project, .craft-section, .about, .contact');
      revealTargets.forEach((item) => item.classList.add('reveal'));
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const revealObserver = new IntersectionObserver((entries, observer) => entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
        }), { threshold: 0.12 });
        revealTargets.forEach((item) => revealObserver.observe(item));
      } else revealTargets.forEach((item) => item.classList.add('is-visible'));
    </script>
  </body>
</html>
