---
import data from '../../shared/data.json' assert { type: 'json' };
const projects = data.featuredProjects.slice(0, 4);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#eeece7" />
    <title>Project Gallery — {data.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root{--paper:#eeece7;--ink:#171816;--muted:#696a65;--line:#c9c7bf;--orange:#e65331;--blue:#3835e8;--mono:'DM Mono',monospace;--font:'Space Grotesk',sans-serif;font-family:var(--font);color:var(--ink);background:var(--paper);font-synthesis:none;scroll-behavior:smooth}*{box-sizing:border-box}body{margin:0;min-width:320px;background:var(--paper)}a{color:inherit;text-decoration:none}button{font:inherit}.shell{width:min(1440px,calc(100% - 48px));margin:auto}.topline{height:72px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:700;letter-spacing:-.03em}.brandmark{width:30px;height:30px;display:grid;place-items:center;background:var(--ink);color:white;font-weight:700}.brand small{display:block;margin-top:2px;color:var(--muted);font:8px var(--mono);letter-spacing:.09em;text-transform:uppercase}.top-meta{display:flex;align-items:center;gap:20px;color:var(--muted);font:8px var(--mono);letter-spacing:.08em;text-transform:uppercase}.top-meta a{padding:10px 13px;border:1px solid var(--ink);color:var(--ink);font:700 9px var(--font);letter-spacing:0;text-transform:none}.stage-wrap{padding:20px 0 13px}.stage-head{display:flex;justify-content:space-between;align-items:center;padding:0 2px 11px;color:var(--muted);font:9px var(--mono);letter-spacing:.1em;text-transform:uppercase}.live-dot{display:inline-block;width:7px;height:7px;margin-right:7px;border-radius:50%;background:#62a94d}.stage{height:min(690px,calc(100svh - 245px));min-height:460px;position:relative;overflow:hidden;background:#d9d6cc;isolation:isolate;transition:background .5s}.stage::before{content:'';position:absolute;inset:0;z-index:-1;background-image:linear-gradient(#17181610 1px,transparent 1px),linear-gradient(90deg,#17181610 1px,transparent 1px);background-size:36px 36px;mask-image:linear-gradient(135deg,black,transparent 86%)}.stage::after{content:'';position:absolute;z-index:-1;width:min(80vw,900px);aspect-ratio:1;right:-8%;top:-48%;border:1px solid #1718162b;border-radius:50%;box-shadow:0 0 0 38px #17181609,0 0 0 77px #17181608,0 0 0 116px #17181607}.stage[data-tone="1"]{background:#d6d5f4}.stage[data-tone="2"]{background:#f3cfba}.stage[data-tone="3"]{background:#d4e9ad}.stage[data-tone="4"]{background:#e9dc9a}.project-slide{position:absolute;inset:0;display:none;animation:slide-in .45s cubic-bezier(.18,.72,.2,1)}.project-slide.active{display:block}@keyframes slide-in{from{opacity:.35;transform:translateX(25px)}to{opacity:1;transform:translateX(0)}}.slide-stamp{position:absolute;top:30px;left:34px;z-index:3;color:#272820;font:9px var(--mono);letter-spacing:.1em;text-transform:uppercase}.slide-stamp span{padding:6px 8px;border:1px solid #17181670;background:#eeece7}.slide-num{position:absolute;right:25px;top:14px;color:#17181620;font:clamp(120px,20vw,270px)/.8 var(--font);font-weight:700;letter-spacing:-.12em}.art-board{position:absolute;top:7%;right:8%;width:58%;height:65%;display:grid;place-items:center;perspective:1000px}.ecommerce-ui{position:relative;width:74%;height:90%;padding:14px;border:2px solid #191a17;background:#f4f2ec;box-shadow:13px 13px #17181640;transform:rotate(-5deg);transition:transform .5s}.project-slide.active .ecommerce-ui{transform:rotate(-4deg) translateY(0)}.browserline{display:flex;justify-content:space-between;padding-bottom:10px;border-bottom:1px solid #1718163b;font:8px var(--mono);text-transform:uppercase}.browserdots{letter-spacing:3px}.commerce-body{display:grid;grid-template-columns:25% 1fr;gap:12px;height:calc(100% - 26px);padding-top:13px}.commerce-side{display:grid;align-content:start;gap:8px;padding:10px;background:#e3e0d6}.commerce-side i{height:5px;background:#17181640}.commerce-side i:first-child{width:55%;background:var(--orange)}.commerce-main{display:grid;grid-template-rows:auto 1fr 40px;gap:9px}.commerce-heading{font-size:clamp(15px,2.3vw,29px);font-weight:700;letter-spacing:-.07em}.commerce-heading small{display:block;color:#7b7b71;font:8px var(--mono);letter-spacing:.08em;text-transform:uppercase}.goods{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.goods i{border:1px solid #1718162c;background:linear-gradient(145deg,#e78769 0 38%,#f0ead8 39%)}.goods i:nth-child(2){background:linear-gradient(145deg,#8292e4 0 38%,#e8e6da 39%)}.goods i:nth-child(3){background:linear-gradient(145deg,#b7c97f 0 38%,#ecebdd 39%)}.commerce-foot{display:flex;align-items:center;justify-content:space-between;padding:0 9px;color:white;background:var(--ink);font:8px var(--mono)}
      .phone-art{position:relative;width:34%;height:95%;padding:10px;border:2px solid #171816;border-radius:31px;background:#171816;box-shadow:12px 14px #17181644;transform:rotate(9deg)}.phone-screen{height:100%;overflow:hidden;border-radius:21px;background:#f7f4ee}.notch{width:43%;height:14px;margin:0 auto 14px;border-radius:0 0 10px 10px;background:#171816}.social-banner{padding:16px 11px 19px;background:#e65331;color:white;font-size:clamp(16px,2.4vw,28px);font-weight:700;line-height:.93;letter-spacing:-.07em;text-transform:uppercase}.social-faces{display:flex;gap:7px;padding:14px 10px 5px}.social-faces i{width:36px;aspect-ratio:1;border:1px solid #171816;border-radius:50%;background:#d9ff50}.social-faces i:nth-child(2){background:#a9a0ff}.social-faces i:nth-child(3){background:#f2a286}.social-lines{padding:5px 11px}.social-lines i{display:block;height:5px;margin:8px 0;background:#1718162d}.social-lines i:nth-child(2){width:68%}.social-post{height:70px;margin:11px;border:1px solid #1718163a;background:linear-gradient(145deg,#d9ff50 0 49%,#20221d 50%)}
      .analytics-ui{width:80%;padding:20px;border:2px solid var(--ink);background:#f4f2ec;box-shadow:13px 13px #1718163c;transform:rotate(3deg)}.analytics-ui .browserline{font-size:9px}.metric-label{margin-top:18px;color:#67685f;font:9px var(--mono);text-transform:uppercase}.metric-value{margin-top:4px;font-size:clamp(27px,4vw,49px);font-weight:700;letter-spacing:-.08em}.metric-value span{color:var(--orange)}.graph{height:170px;margin-top:12px;border-bottom:1px solid var(--ink);background:repeating-linear-gradient(to bottom,transparent 0 40px,#17181613 41px 42px)}.graph svg{width:100%;height:100%;overflow:visible}.graph-key{display:flex;justify-content:space-between;margin-top:9px;color:#66675e;font:8px var(--mono)}
      .care-ui{width:71%;padding:19px;border:2px solid var(--ink);background:#f7f4ed;box-shadow:13px 13px #1718163c;transform:rotate(-3deg)}.care-head{display:flex;justify-content:space-between;padding-bottom:12px;border-bottom:1px solid #17181640;font:9px var(--mono);text-transform:uppercase}.care-title{margin:15px 0 10px;font-size:clamp(20px,3vw,35px);font-weight:700;letter-spacing:-.07em}.patient{display:flex;align-items:center;gap:10px;margin:12px 0;padding:10px;background:#e8e4d8}.patient-avatar{width:34px;height:34px;border-radius:50%;background:#e59d78}.patient-lines{flex:1}.patient-lines i{display:block;width:57%;height:6px;margin:5px;background:#17181638}.patient-lines i:first-child{width:37%;background:var(--ink)}.visit{display:grid;grid-template-columns:70px 1fr auto;gap:7px;padding:12px 4px;border-top:1px solid #17181630;font:8px var(--mono)}.visit b{color:#55753c}
      .slide-copy{position:absolute;z-index:4;left:5%;bottom:7%;width:70%;}.project-kind{display:flex;align-items:center;gap:9px;color:#393a33;font:9px var(--mono);letter-spacing:.12em;text-transform:uppercase}.project-kind::before{content:'';width:25px;height:2px;background:var(--orange)}.slide-copy h1{max-width:950px;margin:10px 0 10px;font-size:clamp(48px,9vw,120px);font-weight:700;line-height:.82;letter-spacing:-.095em;text-transform:uppercase}.slide-copy p{max-width:500px;margin:0;color:#474841;font-size:12px;line-height:1.65}.slide-bottom{display:flex;align-items:center;gap:15px;margin-top:16px}.stack{display:flex;flex-wrap:wrap;gap:5px}.stack span{padding:5px 7px;border:1px solid #17181655;background:#eeece7;font:8px var(--mono)}.ask{padding:7px 9px;color:#f7f5ef;background:#171816;font:8px var(--mono);text-transform:uppercase;white-space:nowrap}.art-1 .slide-copy{width:68%}.art-1 .slide-copy h1{max-width:800px}
      .controlbar{min-height:75px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:22px;border-top:1px solid var(--line)}.control-label{color:var(--muted);font:8px var(--mono);letter-spacing:.1em;text-transform:uppercase}.tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.tab{position:relative;display:flex;align-items:center;gap:9px;padding:12px 8px;border:0;border-top:2px solid transparent;color:#777870;background:transparent;text-align:left;cursor:pointer}.tab[aria-selected="true"]{border-color:var(--ink);color:var(--ink)}.tab:hover{color:var(--orange)}.tab b{font:9px var(--mono)}.tab span{font-size:9px;font-weight:600}.arrows{display:flex;gap:7px}.arrow{width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--ink);color:var(--ink);background:transparent;cursor:pointer}.arrow:hover{color:white;background:var(--ink)}.footer{display:flex;justify-content:space-between;padding:5px 0 16px;color:#777870;font:8px var(--mono);text-transform:uppercase}.footer a:hover{color:var(--orange)}
      @media(max-width:760px){.shell{width:calc(100% - 28px)}.topline{height:60px}.top-meta span{display:none}.top-meta{gap:0}.stage-wrap{padding-top:13px}.stage{height:calc(100svh - 182px);min-height:600px}.slide-stamp{top:18px;left:18px}.slide-num{right:12px;top:20px;font-size:150px}.art-board{top:13%;right:4%;width:92%;height:48%}.ecommerce-ui{width:82%;height:92%;padding:10px}.phone-art{width:42%;height:100%}.analytics-ui,.care-ui{width:83%;padding:14px}.graph{height:115px}.slide-copy,.art-1 .slide-copy{left:6%;bottom:6%;width:88%}.slide-copy h1{font-size:clamp(43px,12vw,78px)}.slide-copy p{max-width:400px;font-size:11px}.slide-bottom{align-items:flex-start;flex-direction:column;gap:9px}.tabs{grid-template-columns:repeat(4,minmax(0,1fr));gap:2px}.controlbar{grid-template-columns:1fr auto;gap:8px;padding:8px 0}.control-label{grid-column:span 2}.tab{justify-content:center;padding:10px 3px}.tab span{display:none}.tab b{font-size:10px}.arrow{width:30px;height:30px}.footer{font-size:7px}}
      @media(max-width:430px){.stage{min-height:620px}.art-board{top:15%;height:43%}.slide-copy{bottom:5%}.slide-copy h1{font-size:clamp(42px,13vw,60px)}.project-kind{font-size:8px}.stack span{font-size:7px}.slide-bottom{margin-top:12px}.footer{gap:12px}.visit{grid-template-columns:52px 1fr auto;font-size:7px}}
      @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="topline"><a class="brand" href="/portfollio/"><span class="brandmark">AS</span><span>AABID SHAIKH<small>INDEPENDENT PRODUCT DEVELOPER</small></span></a><div class="top-meta"><span><i class="live-dot"></i>Navi Mumbai, India · Open to select work</span><a href={`mailto:${data.author.email}`}>Let’s talk ↗</a></div></header>
      <section class="stage-wrap"><div class="stage-head"><span>Portfolio / A selected project gallery</span><span>Navigate the work &nbsp; ← →</span></div><div class="stage" id="gallery-stage" data-tone="1">
        {projects.map((project,index)=><article id={`slide-${index}`} role="tabpanel" aria-labelledby={`tab-${index}`} class={`project-slide art-${index+1} ${index===0?'active':''}`} data-slide={index} aria-hidden={index===0?'false':'true'}><div class="slide-stamp"><span>AABID SHAIKH</span> &nbsp; / &nbsp; PROJECT 0{index+1}</div><div class="slide-num">0{index+1}</div><div class="art-board">{index===0?<div class="ecommerce-ui"><div class="browserline"><span>Marketplace / catalog</span><span class="browserdots">● ● ●</span></div><div class="commerce-body"><div class="commerce-side"><i></i><i></i><i></i><i></i><i></i></div><div class="commerce-main"><div class="commerce-heading"><small>New collection</small>Objects for living</div><div class="goods"><i></i><i></i><i></i></div><div class="commerce-foot"><span>CURATED GOODS</span><span>VIEW ALL ↗</span></div></div></div></div>:index===1?<div class="phone-art"><div class="phone-screen"><div class="notch"></div><div class="social-banner">Your people,<br />in one place.</div><div class="social-faces"><i></i><i></i><i></i></div><div class="social-lines"><i></i><i></i></div><div class="social-post"></div></div></div>:index===2?<div class="analytics-ui"><div class="browserline"><span>Insight / overview</span><span>•••</span></div><div class="metric-label">Activity across your workspace</div><div class="metric-value">Signal<span>.</span></div><div class="graph"><svg viewBox="0 0 500 140" preserveAspectRatio="none" aria-hidden="true"><path d="M0 125 C55 116 48 56 105 78 S171 106 211 55 S267 80 310 48 S370 74 409 26 S458 40 500 8" fill="none" stroke="#e65331" stroke-width="4"/></svg></div><div class="graph-key"><span>WEEK 01</span><span>WEEK 08</span><span>LIVE DATA VIEW</span></div></div>:<div class="care-ui"><div class="care-head"><span>Care / schedule</span><span>09:41 AM</span></div><div class="care-title">Good morning, doctor.</div><div class="patient"><span class="patient-avatar"></span><span class="patient-lines"><i></i><i></i></span><span>↗</span></div><div class="visit"><span>09:30</span><span>Consultation</span><b>READY</b></div><div class="visit"><span>11:00</span><span>Follow-up</span><b>UP NEXT</b></div><div class="visit"><span>13:45</span><span>Video visit</span><b>CONFIRMED</b></div></div>}</div><div class="slide-copy"><div class="project-kind">{project.type==='mobile'?'Mobile experience':'Digital product'} &nbsp; · &nbsp; 0{index+1}</div><h1>{project.name}</h1><p>{project.description}</p><div class="slide-bottom"><div class="stack">{project.stack.slice(0,4).map((item)=><span>{item}</span>)}</div><a class="ask" href={`mailto:${data.author.email}?subject=Question%20about%20${encodeURIComponent(project.name)}`}>Discuss a similar product ↗</a></div></div></article>)}
      </div></section>
      <nav class="controlbar" aria-label="Project gallery navigation"><span class="control-label">Selected work / <span id="active-count">01</span> of 04</span><div class="tabs" role="tablist" aria-label="Choose a project">{projects.map((project,index)=><button class="tab" role="tab" id={`tab-${index}`} aria-selected={index===0?'true':'false'} aria-controls={`slide-${index}`} data-index={index}><b>0{index+1}</b><span>{project.name}</span></button>)}</div><div class="arrows"><button class="arrow" id="previous" aria-label="Previous project">←</button><button class="arrow" id="next" aria-label="Next project">→</button></div></nav>
      <footer class="footer"><span>© {new Date().getFullYear()} {data.name}</span><a href="/portfollio/">Back to the main portfolio ↗</a></footer>
    </main>
    <script>
      const slides=[...document.querySelectorAll('[data-slide]')];const tabs=[...document.querySelectorAll('[role="tab"]')];const stage=document.querySelector('#gallery-stage');const count=document.querySelector('#active-count');let current=0;
      function show(index){current=(index+slides.length)%slides.length;slides.forEach((slide,i)=>{const active=i===current;slide.classList.toggle('active',active);slide.setAttribute('aria-hidden',String(!active));});tabs.forEach((tab,i)=>tab.setAttribute('aria-selected',String(i===current)));stage.dataset.tone=String(current+1);count.textContent=`0${current+1}`;}
      tabs.forEach((tab)=>tab.addEventListener('click',()=>show(Number(tab.dataset.index))));document.querySelector('#next').addEventListener('click',()=>show(current+1));document.querySelector('#previous').addEventListener('click',()=>show(current-1));document.addEventListener('keydown',(event)=>{if(event.key==='ArrowRight')show(current+1);if(event.key==='ArrowLeft')show(current-1);});
    </script>
  </body>
</html>
