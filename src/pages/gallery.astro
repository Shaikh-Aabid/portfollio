---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import ProjectDirectory from '../components/ProjectDirectory.astro';
import data from '../../shared/data.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
---
<PortfolioLayout title={`Project directory — ${data.name}`} description={`Explore ${data.name}’s web platforms, mobile applications, and business systems. Search the complete portfolio by name, industry, or platform.`} path="gallery/">
<section class="container section gallery-page"><a class="text-link" href={base}>← Back to the portfolio</a><div class="section-heading"><div><p class="eyebrow">THE COMPLETE COLLECTION</p><h1>Built across<br/><span>different worlds.</span></h1></div><p>{data.featuredProjects.length} projects across mobility, commerce, workforce operations, maritime services, and more.</p></div><ProjectDirectory/></section>
</PortfolioLayout>
