---
import data from '../../shared/data.json' assert { type: 'json' };
const projects = data.featuredProjects.slice(0, 4);
const stackGroups = [
  { name: 'Frontend', items: ['Vue.js / Nuxt', 'React / Next.js', 'TypeScript', 'Tailwind CSS'] },
  { name: 'Backend & APIs', items: ['Laravel / PHP', 'Node.js / Express', 'GraphQL / REST'] },
  { name: 'Mobile', items: ['Flutter / Dart', 'Firebase'] },
  { name: 'Data & delivery', items: ['SQL / NoSQL', 'Docker / DevOps', 'CI/CD'] },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10120f" />
    <title>Product Lab · {data.name}</title>
    <style>
      :root{--bg:#10120f;--surface:#1a1d19;--surface2:#20231f;--ink:#f4f2e9;--muted:#a4a69d;--line:#373a34;--acid:#d9ff50;--orange:#ff6947;--lav:#a9a0ff;--mono:'DM Mono',monospace;--display:'Space Grotesk',sans-serif;color:var(--ink);background:var(--bg);font-family:var(--display),sans-serif;font-synthesis:none;scroll-behavior:smooth}*{box-sizing:border-box}body{margin:0;min-width:320px;background:radial-gradient(ellipse at 78% 21%,#252b1e 0,transparent 36%),var(--bg);color:var(--ink)}a{color:inherit;text-decoration:none}button{font:inherit}.wrap{width:min(1180px,calc(100% - 50px));margin:auto}.mono{font:9px var(--mono);letter-spacing:.1em;text-transform:uppercase}.header{position:sticky;top:0;z-index:20;border-bottom:1px solid #ffffff18;background:#10120fe8;backdrop-filter:blur(14px)}.nav{height:66px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:700;letter-spacing:-.03em}.brand-mark{width:30px;height:30px;display:grid;place-items:center;color:var(--bg);background:var(--acid);font-size:12px;font-weight:800}.nav-links{display:flex;align-items:center;gap:26px;color:#d2d2c9;font-size:10px}.nav-links a:hover{color:var(--acid)}.nav-cta{padding:10px 13px;color:var(--bg)!important;background:var(--acid);font-weight:700}.hero{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:center;min-height:620px;padding:76px 0 66px;overflow:hidden}.hero-copy{position:relative;z-index:2}.status{display:inline-flex;align-items:center;gap:9px;padding:8px 11px;border:1px solid #ffffff23;border-radius:99px;color:#c0c2b7}.pulse{width:7px;height:7px;border-radius:50%;background:var(--acid);box-shadow:0 0 0 5px #d9ff5018}.hero h1{max-width:650px;margin:24px 0;font-size:clamp(53px,7.7vw,93px);font-weight:600;line-height:.89;letter-spacing:-.085em}.hero h1 span{color:var(--acid)}.hero-copy>p{max-width:465px;color:#b8bab1;font-size:14px;line-height:1.8}.hero-actions{display:flex;gap:12px;margin-top:25px}.button{min-height:44px;display:inline-flex;align-items:center;gap:12px;padding:0 15px;border:1px solid #ffffff36;font-size:10px;font-weight:700;transition:.2s}.button:hover{transform:translateY(-2px);border-color:var(--acid)}.button.hot{border-color:var(--acid);color:var(--bg);background:var(--acid)}.hero-foot{display:flex;align-items:center;gap:12px;margin-top:42px;color:#85877f}.hero-foot i{width:26px;height:1px;background:var(--acid)}
      .lab-scene{min-height:480px;position:relative;display:grid;place-items:center}.lab-grid{position:absolute;inset:8%;border:1px solid #ffffff17;border-radius:50%;background:radial-gradient(circle at center,#d9ff500b 0 18%,transparent 18.5%),radial-gradient(#ffffff13 .7px,transparent .7px);background-size:auto,16px 16px;box-shadow:inset 0 0 70px #d9ff5006}.ring{position:absolute;width:76%;aspect-ratio:1;border:1px solid #d9ff5038;border-radius:50%;transform:rotate(-18deg) scaleY(.56)}.ring.two{width:57%;border-style:dashed;border-color:#a9a0ff78;transform:rotate(25deg) scaleY(.88)}.ring.three{width:91%;border-color:#ffffff18;transform:rotate(58deg) scaleY(.36)}.core{position:relative;z-index:1;width:156px;height:156px;display:grid;place-items:center;border:1px solid #f1ffaf;color:var(--bg);background:radial-gradient(circle at 37% 29%,#f5ffc1,var(--acid) 68%);border-radius:50%;box-shadow:0 0 75px #d9ff503d,0 0 0 18px #d9ff5009;font-size:43px;font-weight:700;letter-spacing:-.1em}.core::after{content:'PRODUCT\A ENGINEER';position:absolute;top:calc(100% + 12px);color:#d3d4ca;text-align:center;white-space:pre;font:8px/1.65 var(--mono);letter-spacing:.13em}.satellite{position:absolute;z-index:3;width:132px;padding:10px 11px;border:1px solid #ffffff37;color:var(--ink);background:#191c18ed;box-shadow:0 15px 35px #0006;transition:transform .24s,border-color .24s,background .24s;cursor:pointer;text-align:left}.satellite:hover,.satellite[aria-pressed="true"]{transform:translateY(-4px) scale(1.04);border-color:var(--acid);background:#252a20}.satellite b{display:block;padding-right:17px;font-size:10px}.satellite small{display:block;margin-top:5px;color:#aeb0a6;font:7px var(--mono);text-transform:uppercase}.satellite .sat-no{position:absolute;top:9px;right:9px;color:var(--acid);font:8px var(--mono)}.satellite.s1{top:10%;left:2%}.satellite.s2{top:20%;right:0}.satellite.s3{bottom:20%;left:0}.satellite.s4{right:2%;bottom:9%}.scene-label{position:absolute;top:0;left:2%;color:#b2b4a9}.scene-coord{position:absolute;bottom:0;right:2%;color:#8e9088}
      .signal-strip{border-block:1px solid #ffffff1d;background:#161914}.signal-inner{min-height:73px;display:grid;grid-template-columns:repeat(4,1fr);align-items:center}.signal{display:flex;align-items:center;gap:11px;padding:12px 20px;border-right:1px solid #ffffff19}.signal:first-child{padding-left:0}.signal:last-child{border:0}.signal strong{font-size:18px;letter-spacing:-.06em}.signal span{color:#999b91;font:8px/1.55 var(--mono);text-transform:uppercase}
      #projects,#stack,#approach{scroll-margin-top:82px}#projects{padding-bottom:48px}#approach{padding-top:50px}.ring.two{animation:ring-drift 44s linear infinite}@keyframes ring-drift{to{transform:rotate(385deg) scaleY(.88)}}.pulse{animation:status-pulse 2.4s ease-in-out infinite}@keyframes status-pulse{50%{box-shadow:0 0 0 8px #d9ff5008,0 0 16px #d9ff5066}}.project-detail{--project-accent:var(--acid);transition:border-color .25s}.project-detail[data-project-index="1"]{--project-accent:var(--lav)}.project-detail[data-project-index="2"]{--project-accent:#65ddd2}.project-detail[data-project-index="3"]{--project-accent:var(--orange)}.project-detail .detail-copy,.project-detail .detail-visual{transition:opacity .18s ease,transform .18s ease}.project-detail.is-changing .detail-copy,.project-detail.is-changing .detail-visual{opacity:0;transform:translateY(7px) scale(.985)}.project-detail .detail-copy .mono,.project-detail .detail-tags span{transition:border-color .2s,color .2s}.project-detail .detail-copy .mono{color:var(--project-accent)}:global(.detail-tag){padding:6px 8px;border:1px solid #ffffff29;color:#d1d2c9;font:8px var(--mono);transition:border-color .2s,color .2s}:global(.detail-tag:hover){border-color:var(--project-accent);color:var(--project-accent)}.detail-visual::before,.detail-visual::after{border-color:color-mix(in srgb,var(--project-accent) 27%,transparent)}.visual-side i:first-child{background:var(--project-accent)}.visual-cards i:first-child{background:linear-gradient(145deg,color-mix(in srgb,var(--project-accent) 60%,transparent) 0 40%,#54584d 41%)}.project-detail[data-project-index="1"] .visual-window{width:47%;max-width:145px;padding:10px;border:2px solid #ffffff6b;border-radius:17px;background:#1a1d19;transform:rotate(2deg)}.project-detail[data-project-index="1"] .visual-content{height:154px}.project-detail[data-project-index="1"] .visual-side{grid-template-columns:1fr 1fr;align-content:start}.project-detail[data-project-index="1"] .visual-side i{height:5px}.project-detail[data-project-index="2"] .visual-window{width:86%;transform:rotate(-1deg)}.project-detail[data-project-index="2"] .visual-cards i{clip-path:polygon(0 65%,20% 52%,38% 58%,58% 24%,77% 37%,100% 8%,100% 100%,0 100%)}.project-detail[data-project-index="3"] .visual-cards i:nth-child(2){background:linear-gradient(145deg,#ff694788 0 40%,#54584d 41%)}
      .section{padding:94px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:29px}.kicker{color:var(--acid)}h2{margin:9px 0 0;font-size:clamp(35px,5vw,58px);line-height:.94;letter-spacing:-.07em}.section-head p{max-width:380px;margin:0;color:#aaaca2;font-size:11px;line-height:1.7}.project-explorer{display:grid;grid-template-columns:.74fr 1.26fr;min-height:390px;border:1px solid #ffffff25;background:var(--surface)}.project-picker{display:grid;align-content:start;padding:12px;border-right:1px solid #ffffff25}.project-tab{position:relative;display:grid;grid-template-columns:39px 1fr 18px;gap:10px;align-items:center;padding:17px 12px;border:0;border-bottom:1px solid #ffffff1d;color:var(--ink);background:transparent;text-align:left;cursor:pointer}.project-tab:last-child{border-bottom:0}.project-tab:hover,.project-tab[aria-selected="true"]{background:#ffffff08}.project-tab[aria-selected="true"]::before{content:'';position:absolute;left:-12px;top:13px;bottom:13px;width:3px;background:var(--acid)}.tab-no{color:#92948b;font:9px var(--mono)}.tab-title{font-size:12px;font-weight:700}.tab-type{display:block;margin-top:4px;color:#999b91;font:7px var(--mono);text-transform:uppercase}.tab-arrow{color:var(--acid)}.project-detail{position:relative;display:grid;grid-template-columns:1fr .82fr;gap:24px;align-items:center;padding:34px}.detail-copy .mono{color:var(--acid)}.detail-copy h3{margin:11px 0;font-size:clamp(25px,3.5vw,43px);line-height:.98;letter-spacing:-.07em}.detail-copy p{max-width:400px;color:#b4b6ac;font-size:12px;line-height:1.75}.detail-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:20px}.detail-tags span{padding:6px 8px;border:1px solid #ffffff29;color:#d1d2c9;font:8px var(--mono)}.detail-visual{min-height:245px;position:relative;display:grid;place-items:center;overflow:hidden;border:1px solid #ffffff24;background:radial-gradient(ellipse at center,#313b24,#1a1d19 70%)}.detail-visual::before,.detail-visual::after{content:'';position:absolute;width:230px;height:230px;border:1px solid #d9ff5028;border-radius:50%}.detail-visual::after{width:160px;height:160px;border-style:dashed;transform:rotate(42deg) scaleY(.6)}.visual-window{position:relative;z-index:1;width:73%;padding:11px;border:1px solid #ffffff4a;background:#252a22;box-shadow:0 15px 32px #0007;transform:rotate(-4deg)}.visual-top{display:flex;justify-content:space-between;padding-bottom:8px;border-bottom:1px solid #ffffff28;color:#c0c1b8;font:7px var(--mono);text-transform:uppercase}.visual-content{display:grid;grid-template-columns:24% 1fr;gap:8px;height:105px;padding-top:9px}.visual-side{display:grid;align-content:start;gap:7px;padding:7px;background:#34382e}.visual-side i{height:4px;background:#85877d}.visual-side i:first-child{width:58%;background:var(--acid)}.visual-main{display:grid;grid-template-rows:12px 1fr;gap:6px}.visual-main>i{width:48%;height:7px;background:#ebeadf}.visual-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.visual-cards i{background:linear-gradient(145deg,#d9ff5077 0 40%,#54584d 41%)}.visual-cards i:nth-child(2){background:linear-gradient(145deg,#a9a0ff99 0 40%,#54584d 41%)}.visual-cards i:nth-child(3){background:linear-gradient(145deg,#ff694788 0 40%,#54584d 41%)}
      .stack-section{padding-top:58px;padding-bottom:56px}.stack-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.stack-group{min-height:198px;padding:17px;border:1px solid #ffffff20;background:linear-gradient(145deg,#1b1e19,#151713);transition:transform .2s,border-color .2s}.stack-group:hover{transform:translateY(-3px);border-color:#d9ff506b}.stack-group-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:13px;border-bottom:1px solid #ffffff1c;color:var(--acid)}.stack-group ul{display:grid;gap:0;margin:5px 0 0;padding:0;list-style:none}.stack-group li{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid #ffffff12;color:#e2e1d8;font-size:10px}.stack-group li:last-child{border-bottom:0}.stack-group li small{flex:none;color:#92948b;font:8px var(--mono)}.method{display:grid;grid-template-columns:1fr 1fr;gap:10px}.method-card{min-height:165px;padding:20px;border:1px solid #ffffff20;background:#171a16}.method-card .mono{color:var(--acid)}.method-card h3{margin:25px 0 8px;font-size:18px;letter-spacing:-.05em}.method-card p{max-width:420px;margin:0;color:#a7a99f;font-size:10px;line-height:1.7}.contact{display:flex;align-items:center;justify-content:space-between;gap:22px;margin-bottom:55px;padding:32px;border:1px solid #d9ff5048;background:linear-gradient(110deg,#20251a,#171a16)}.contact h2{max-width:600px;margin:9px 0;font-size:clamp(34px,5vw,58px)}.contact p{margin:0;color:#adafa4;font-size:11px}.contact .button{white-space:nowrap}.footer{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid #ffffff20;padding:18px 0 28px;color:#a4a69d;font:10px/1.6 var(--mono);text-transform:uppercase}.footer-links{display:flex;flex-wrap:wrap;gap:10px 20px}.footer-links a{padding:3px 0}.footer a:hover{color:var(--acid)}
      @media(max-width:800px){.hero{grid-template-columns:1fr;gap:0;padding:60px 0 38px}.hero-copy{max-width:700px}.lab-scene{min-height:440px}.project-explorer{grid-template-columns:1fr}.project-picker{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;border-right:0;border-bottom:1px solid #ffffff25}.project-tab{border:1px solid #ffffff20}.project-tab[aria-selected="true"]::before{left:0;top:0;bottom:0}.project-detail{grid-template-columns:minmax(0,1fr) minmax(210px,.82fr);padding:24px}.stack-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.footer{align-items:flex-start;flex-direction:column;gap:10px}.signal{padding-inline:12px}}
      @media(max-width:620px){.wrap{width:calc(100% - 32px)}.nav{height:57px}.nav-links{gap:13px}.nav-links a:first-child{display:none}.hero{padding-top:48px}.hero h1{font-size:clamp(54px,15vw,82px)}.hero-copy>p{font-size:13px}.lab-scene{min-height:365px;margin-top:16px}.core{width:115px;height:115px;font-size:35px}.satellite{width:115px;padding:9px}.satellite.s1{left:0}.satellite.s2{right:0}.satellite.s3{left:0}.satellite.s4{right:0}.signal-inner{grid-template-columns:1fr 1fr}.signal{min-height:65px;border-bottom:1px solid #ffffff19}.signal:nth-child(2){border-right:0}.signal:nth-child(3){padding-left:0;border-bottom:0}.signal:nth-child(4){border-bottom:0}.section{padding:65px 0}.section-head{display:block}.section-head p{margin-top:12px}.project-explorer{grid-template-columns:1fr}.project-picker{grid-template-columns:1fr 1fr;gap:6px;border-right:0;border-bottom:1px solid #ffffff25}.project-tab{grid-template-columns:26px 1fr;padding:12px 7px;border:1px solid #ffffff20}.tab-arrow{display:none}.project-tab[aria-selected="true"]::before{left:0;top:0;bottom:0}.tab-title{font-size:10px}.tab-type{font-size:6px}.project-detail{grid-template-columns:1fr;padding:20px}.detail-visual{min-height:205px;grid-row:1}.stack-grid{grid-template-columns:1fr}.stack-group{min-height:0}.stack-group li{padding:9px 0}.method{grid-template-columns:1fr}.method-card{min-height:135px}.method-card h3{margin-top:18px}.contact{align-items:flex-start;flex-direction:column;padding:24px 20px}.footer{flex-direction:column}}
      @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important}}
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="header"><nav class="wrap nav"><a class="brand" href="#top"><span class="brand-mark">AS</span><span>AABID SHAIKH <span style="color:#a4a69d;font-weight:400">/ PRODUCT LAB</span></span></a><div class="nav-links"><a href="#projects">Project explorer</a><a href="#stack">Stack</a><a href="#approach">Approach</a><a class="nav-cta" href={`mailto:${data.author.email}`}>Start a project ↗</a></div></nav></header>
    <main id="top">
      <section class="wrap hero"><div class="hero-copy"><div class="status"><span class="pulse"></span> Available for select projects · Navi Mumbai, India</div><h1>I make ideas<br />work in the<br /><span>real world.</span></h1><p>I’m Aabid, a full stack and mobile developer. I connect product thinking with engineering craft to build digital experiences people can use with confidence.</p><div class="hero-actions"><a class="button hot" href="#projects">Explore the lab <span>↓</span></a><a class="button" href={`mailto:${data.author.email}`}>Tell me what you’re building ↗</a></div><div class="hero-foot mono"><i></i>From first sketch to a product ready to ship</div></div>
        <div class="lab-scene"><span class="scene-label mono">SYSTEM MAP / 01</span><div class="lab-grid"></div><div class="ring"></div><div class="ring two"></div><div class="ring three"></div><div class="core">AS</div>{projects.map((project,index)=><button class={`satellite s${index+1}`} data-project={index} aria-pressed={index===0?'true':'false'}><span class="sat-no">0{index+1}</span><b>{project.name}</b><small>{project.stack.slice(0,2).join(' · ')}</small></button>)}<span class="scene-coord mono">19°04′ N &nbsp; 72°52′ E</span></div>
      </section>
      <section class="signal-strip"><div class="wrap signal-inner"><div class="signal"><strong>{data.years}+</strong><span>Years building<br />digital products</span></div><div class="signal"><strong>Web</strong><span>Interfaces to<br />backend systems</span></div><div class="signal"><strong>Mobile</strong><span>Cross-platform<br />Flutter apps</span></div><div class="signal"><strong>Ship</strong><span>Delivery-minded<br />engineering</span></div></div></section>
      <section class="wrap section" id="projects"><div class="section-head"><div><span class="kicker mono">Interactive project explorer / 02</span><h2>Pick a product.<br />See how it works.</h2></div><p>Choose a project to inspect its product challenge, technology stack, and the systems behind the interface.</p></div>
        <div class="project-explorer"><div class="project-picker" role="tablist" aria-label="Select a project">{projects.map((project,index)=><button class="project-tab" id={`project-tab-${index}`} role="tab" aria-selected={index===0?'true':'false'} aria-controls="project-detail" tabindex={index===0?'0':'-1'} data-project={index}><span class="tab-no">0{index+1}</span><span><span class="tab-title">{project.name}</span><span class="tab-type">{project.type === 'mobile' ? 'Mobile product' : 'Web platform'}</span></span><span class="tab-arrow">↗</span></button>)}</div><article class="project-detail" id="project-detail" data-project-index="0" role="tabpanel" aria-labelledby="project-tab-0"><div class="detail-copy"><span class="mono" id="detail-kind">WEB PLATFORM · BUILD 01</span><h3 id="detail-title">{projects[0].name}</h3><p id="detail-description">{projects[0].description}</p><div class="detail-tags" id="detail-tags">{projects[0].stack.map((item)=><span>{item}</span>)}</div></div><div class="detail-visual" aria-label="Stylized product interface illustration"><div class="visual-window"><div class="visual-top"><span>Product / workspace</span><span>•••</span></div><div class="visual-content"><div class="visual-side"><i></i><i></i><i></i><i></i></div><div class="visual-main"><i></i><div class="visual-cards"><i></i><i></i><i></i></div></div></div></div></div></article></div>
      </section>
      <section class="wrap section stack-section" id="stack"><div class="section-head"><div><span class="kicker mono">My stack / 03</span><h2>The tools behind the build.</h2></div><p>Hands-on across the product: interfaces, APIs, mobile apps, data, and the delivery work that connects them.</p></div><div class="stack-grid">{stackGroups.map((group,index)=><article class="stack-group"><div class="stack-group-head"><span class="mono">0{index+1} / {group.name}</span><span aria-hidden="true">↗</span></div><ul>{group.items.map((item)=><li><span>{item}</span><small>{data.skills[item]}</small></li>)}</ul></article>)}</div></section>
      <section class="wrap section" id="approach"><div class="section-head"><div><span class="kicker mono">How I work / 04</span><h2>Thoughtful at every layer.</h2></div><p>Strong products come from connecting the details: what users need, what the system can support, and what a team can keep improving.</p></div><div class="method"><article class="method-card"><span class="mono">01 · Understand</span><h3>Find the real problem.</h3><p>Get close to the people, constraints, and workflows before choosing a solution.</p></article><article class="method-card"><span class="mono">02 · Shape</span><h3>Make the path clear.</h3><p>Turn product requirements into a useful first release with a solid technical foundation.</p></article><article class="method-card"><span class="mono">03 · Build</span><h3>Care about the details.</h3><p>Connect responsive interfaces, dependable APIs, data, and integrations into one experience.</p></article><article class="method-card"><span class="mono">04 · Improve</span><h3>Keep learning after launch.</h3><p>Use feedback and real product needs to guide what comes next.</p></article></div></section>
      <section class="wrap contact"><div><span class="kicker mono">Have a product in mind?</span><h2>Let’s make the next thing useful.</h2><p>Share the challenge and we can figure out a good first step.</p></div><a class="button hot" href={`mailto:${data.author.email}`}>Email Aabid ↗</a></section>
    </main>
    <footer class="wrap footer"><span>© {new Date().getFullYear()} {data.name} · Navi Mumbai, India</span><span class="footer-links"><a href={data.author.github}>GitHub ↗</a><a href={data.author.linkedin}>LinkedIn ↗</a><a href="/portfollio/">Back to live portfolio ↗</a></span></footer>
    <script define:vars={{projects}}>
      const tabs=[...document.querySelectorAll('.project-tab')];
      const satellites=[...document.querySelectorAll('.satellite')];
      const panel=document.querySelector('#project-detail');
      function selectProject(index){
        const project=projects[index];
        panel?.classList.add('is-changing');
        tabs.forEach((tab,i)=>{const active=i===index;tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1;});
        satellites.forEach((tab,i)=>tab.setAttribute('aria-pressed',String(i===index)));
        panel?.setAttribute('aria-labelledby',`project-tab-${index}`);
        if(panel)panel.dataset.projectIndex=String(index);
        document.querySelector('#detail-kind').textContent=`${project.type==='mobile'?'MOBILE PRODUCT':'WEB PLATFORM'} · BUILD 0${index+1}`;
        document.querySelector('#detail-title').textContent=project.name;
        document.querySelector('#detail-description').textContent=project.description;
        document.querySelector('#detail-tags').replaceChildren(...project.stack.map((item)=>{const tag=document.createElement('span');tag.className='detail-tag';tag.textContent=item;return tag;}));
        window.setTimeout(()=>panel?.classList.remove('is-changing'),180);
      }
      [...tabs,...satellites].forEach((button)=>button.addEventListener('click',()=>selectProject(Number(button.dataset.project))));
      tabs.forEach((tab,index)=>tab.addEventListener('keydown',(event)=>{if(!['ArrowDown','ArrowUp','Home','End'].includes(event.key))return;event.preventDefault();const next=event.key==='Home'?0:event.key==='End'?tabs.length-1:(index+(event.key==='ArrowDown'?1:tabs.length-1))%tabs.length;selectProject(next);tabs[next].focus();}));
    </script>
  </body>
</html>
