---
const concepts = [
  { id: 'orbit', number: '01', name: 'Orbit', note: 'Projects as a connected system' },
  { id: 'desktop', number: '02', name: 'Desktop', note: 'Your portfolio as a workspace' },
  { id: 'poster', number: '03', name: 'Poster', note: 'A graphic, image-led story' },
  { id: 'blueprint', number: '04', name: 'Blueprint', note: 'Engineering as a visual map' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#eeeae1" />
    <title>Creative Portfolio Directions | Aabid Shaikh</title>
    <style>
      :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color:#151719; background:#eeece6; font-synthesis:none; }
      * { box-sizing:border-box; }
      body { margin:0; padding:28px 20px 55px; }
      button,a { font:inherit; }
      .shell { width:min(1180px,100%); margin:auto; }
      .intro { display:flex; align-items:end; justify-content:space-between; gap:25px; margin:0 0 17px; }
      .intro .eyebrow { color:#74736f; font-size:10px; font-weight:800; letter-spacing:.15em; text-transform:uppercase; }
      .intro h1 { margin:7px 0 0; font-size:clamp(26px,4vw,38px); line-height:1; letter-spacing:-.06em; }
      .intro p { max-width:345px; margin:0; color:#65645f; font-size:12px; line-height:1.6; }
      .tabs { display:grid; grid-template-columns:repeat(4,1fr); gap:9px; margin-bottom:14px; }
      .tab { min-height:64px; padding:10px 13px; border:1px solid #d8d6ce; border-radius:10px; color:#222; background:#faf9f6; text-align:left; cursor:pointer; transition:.18s ease; }
      .tab:hover { transform:translateY(-2px); border-color:#777; }
      .tab[aria-selected="true"] { border-color:#17191c; box-shadow:0 0 0 2px #16171912; background:white; }
      .tab strong { display:block; margin-bottom:4px; font-size:13px; }
      .tab span { color:#73716d; font-size:10px; }
      .frame { min-height:700px; overflow:hidden; border:1px solid #d8d6ce; border-radius:15px; background:white; box-shadow:0 20px 55px #16171912; }
      .demo { display:none; min-height:700px; color:var(--ink); background:var(--paper); }
      .demo.active { display:block; animation:enter .24s ease-out; }
      @keyframes enter { from { opacity:.5; transform:translateY(5px); } to { opacity:1; transform:none; } }
      .demo a { color:inherit; text-decoration:none; }
      .nav { height:58px; display:flex; align-items:center; justify-content:space-between; padding:0 5.5%; color:var(--ink); font-size:10px; }
      .brand { font-weight:900; letter-spacing:-.04em; }
      .navlinks { display:flex; gap:20px; color:var(--muted); }
      .eyebrow { color:var(--accent); font-size:9px; font-weight:850; letter-spacing:.14em; text-transform:uppercase; }
      .cta { display:inline-flex; align-items:center; min-height:35px; padding:0 13px; border:1px solid var(--line); border-radius:5px; color:var(--ink); font-size:10px; font-weight:800; }
      .cta.hot { border-color:var(--accent); color:var(--hot-text,white); background:var(--accent); }
      .project-tags { display:flex; flex-wrap:wrap; gap:6px; }
      .project-tags span { padding:5px 8px; border:1px solid var(--line); border-radius:999px; color:var(--muted); font-size:8px; }
      /* 01 Orbit: projects and skills form a visual constellation around the developer. */
      .orbit { --paper:#111319; --ink:#f6f5f1; --muted:#a8a9b0; --accent:#c7f36c; --hot-text:#151714; --line:#353741; }
      .orbit .nav { border-bottom:1px solid #ffffff18; }
      .orbit-stage { position:relative; min-height:450px; display:grid; grid-template-columns:.9fr 1.1fr; gap:22px; align-items:center; padding:38px 7% 34px; overflow:hidden; }
      .orbit-stage::before { content:""; position:absolute; width:560px; height:560px; right:4%; top:50%; transform:translateY(-50%); border:1px solid #ffffff17; border-radius:50%; }
      .orbit-stage::after { content:""; position:absolute; width:390px; height:390px; right:12%; top:50%; transform:translateY(-50%); border:1px dashed #ffffff26; border-radius:50%; }
      .orbit-copy { position:relative; z-index:3; }
      .orbit h2 { margin:14px 0; max-width:430px; font-size:clamp(44px,6.7vw,80px); line-height:.9; letter-spacing:-.08em; }
      .orbit-copy p { max-width:360px; color:var(--muted); font-size:12px; line-height:1.7; }
      .orbit-copy .cta { margin-top:12px; }
      .constellation { position:relative; z-index:2; width:min(100%,480px); aspect-ratio:1; justify-self:center; }
      .ring { position:absolute; inset:10%; border:1px solid #c7f36c40; border-radius:50%; transform:rotate(-23deg) scaleY(.72); }
      .ring.r2 { inset:19%; border-style:dashed; transform:rotate(42deg) scaleY(.82); }
      .core { position:absolute; left:50%; top:50%; width:130px; height:130px; display:grid; place-items:center; transform:translate(-50%,-50%); border:1px solid #c7f36c8c; border-radius:50%; color:#171a14; background:radial-gradient(circle at 33% 28%,#f0ffc7,#c7f36c 68%); box-shadow:0 0 55px #c7f36c32; font-size:34px; font-weight:900; letter-spacing:-.09em; }
      .node { position:absolute; z-index:2; padding:9px 11px; border:1px solid #ffffff35; border-radius:7px; color:#f6f5f1; background:#20232b; font-size:9px; box-shadow:0 8px 24px #0005; }
      .node small { display:block; margin-top:3px; color:#aeb0b7; font-size:7px; }
      .node.n1 { left:4%; top:21%; }.node.n2 { right:0; top:27%; }.node.n3 { left:2%; bottom:22%; }.node.n4 { right:4%; bottom:17%; }
      .orbit-bottom { display:flex; justify-content:space-between; gap:20px; padding:17px 7%; border-top:1px solid #ffffff18; color:var(--muted); font-size:9px; }
      .orbit-bottom strong { color:var(--ink); }
      /* 02 Desktop: a portfolio as a playful workstation with purposeful window-like panels. */
      .desktop { --paper:#dfe4dc; --ink:#1a2423; --muted:#697571; --accent:#435be8; --hot-text:#fff; --line:#c4cec4; }
      .desktop .nav { height:48px; padding:0 3%; }
      .desk-shell { min-height:650px; margin:0 2.5% 2.5%; padding:20px; border:1px solid #bec7bc; border-radius:14px; background:linear-gradient(135deg,#e8eee5,#d6dfd5); box-shadow:inset 0 1px #fff; }
      .desk-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; font-size:9px; }
      .desk-top .time { color:var(--muted); font-variant-numeric:tabular-nums; }
      .desk-grid { display:grid; grid-template-columns:135px 1fr 180px; gap:13px; }
      .desk-profile,.desk-widget,.file-card,.app-window { border:1px solid #c3cbc4; border-radius:10px; background:#f4f6f1e8; box-shadow:0 7px 20px #263b2920; }
      .desk-profile { padding:13px; }
      .avatar-stamp { width:62px; height:62px; display:grid; place-items:center; margin-bottom:12px; border-radius:16px; color:#fff; background:#243f38; font-size:22px; font-weight:900; }
      .desk-profile strong { display:block; font-size:12px; }
      .desk-profile p { margin:5px 0 13px; color:var(--muted); font-size:9px; line-height:1.5; }
      .desk-profile .online { color:#327744; font-size:8px; font-weight:800; }
      .desk-files { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; align-content:start; }
      .file-card { min-height:130px; padding:9px; color:var(--ink); }
      .file-glyph { width:34px; height:43px; position:relative; display:grid; place-items:center; margin-bottom:10px; border:1px solid #8793e7; border-radius:4px; color:#435be8; background:#dfe3ff; font-size:14px; }
      .file-glyph::after { content:""; position:absolute; top:-1px; right:-1px; width:11px; height:11px; border-left:1px solid #8793e7; border-bottom:1px solid #8793e7; border-radius:0 3px 0 4px; background:#f4f6f1; }
      .file-card strong { display:block; font-size:9px; line-height:1.3; }
      .file-card small { color:var(--muted); font-size:7px; }
      .app-window { grid-column:span 3; overflow:hidden; }
      .app-titlebar { height:29px; display:flex; align-items:center; justify-content:space-between; padding:0 10px; border-bottom:1px solid var(--line); color:var(--muted); font-size:8px; }
      .app-titlebar .lights { display:flex; gap:4px; }.app-titlebar i { width:6px;height:6px;border-radius:50%;background:#e78b6d; }.app-titlebar i:nth-child(2){background:#e6bf61}.app-titlebar i:nth-child(3){background:#78ad77}
      .app-content { display:grid; grid-template-columns:1.1fr .9fr; gap:15px; padding:15px; }
      .app-content h2 { margin:7px 0; font-size:25px; line-height:1; letter-spacing:-.06em; }
      .app-content p { max-width:280px; color:var(--muted); font-size:9px; line-height:1.6; }
      .app-screenshot { min-height:115px; display:flex; align-items:center; justify-content:center; border:1px solid #d2d8d0; border-radius:7px; background:linear-gradient(145deg,#dce3ff,#c5d6ce); }
      .app-screenshot div { width:72%; height:70px; padding:10px; border-radius:5px; background:#f9faf8; box-shadow:0 7px 18px #2335; }
      .app-screenshot i { display:block; height:7px; width:52%; margin-bottom:7px; border-radius:5px; background:#435be8; }.app-screenshot i:nth-child(2){width:90%;height:25px;background:#dde3ff}.app-screenshot i:nth-child(3){width:68%;background:#c7d1ca}
      .desk-widget { padding:13px; }.desk-widget h3 { margin:7px 0 12px; font-size:13px; }.desk-widget .stackline { padding:8px 0; border-top:1px solid var(--line); color:var(--muted); font-size:8px; }.desk-widget .big-number { color:var(--accent); font-size:31px; font-weight:900; letter-spacing:-.07em; }
      .desk-dock { display:flex; justify-content:center; gap:8px; width:max-content; max-width:100%; margin:16px auto 0; padding:8px 12px; border:1px solid #bcc5bb; border-radius:12px; background:#f4f6f1b8; }.desk-dock span { width:27px;height:27px;display:grid;place-items:center;border-radius:7px;color:white;background:#435be8;font-size:9px;font-weight:800; }.desk-dock span:nth-child(2){background:#b85b42}.desk-dock span:nth-child(3){background:#202a26}.desk-dock span:nth-child(4){background:#759c45}
      /* 03 Poster: project as an art-directed cover, with type and abstract product imagery. */
      .poster { --paper:#f5efe4; --ink:#1e201c; --muted:#66675e; --accent:#f05b3e; --hot-text:#fff; --line:#d7cfc1; }
      .poster .nav { border-bottom:1px solid var(--line); }
      .poster-top { display:grid; grid-template-columns:.92fr 1.08fr; min-height:360px; padding:25px 5.5% 30px; }
      .poster-copy { position:relative; z-index:2; align-self:center; }
      .poster-copy h2 { margin:14px 0; font-size:clamp(52px,8vw,100px); line-height:.76; letter-spacing:-.09em; }
      .poster-copy p { max-width:280px; color:var(--muted); font-size:11px; line-height:1.65; }
      .poster-image { min-height:300px; position:relative; overflow:hidden; background:#f05b3e; }
      .poster-image::before { content:"MARKET\A PLACE"; white-space:pre; position:absolute; z-index:1; top:13px; left:15px; color:#211e1a; font-size:clamp(42px,7vw,83px); font-weight:950; line-height:.72; letter-spacing:-.1em; }
      .poster-shape { position:absolute; width:73%; height:68%; right:-4%; bottom:-3%; border:1px solid #27231d; border-radius:48% 48% 0 0; background:#e9c952; transform:rotate(-9deg); }
      .poster-shape::before { content:""; position:absolute; width:54%; height:55%; left:22%; top:18%; border:1px solid #27231d; border-radius:8px; background:#f9f4e9; box-shadow:10px 10px 0 #27231d; }
      .poster-shape::after { content:""; position:absolute; left:33%; top:35%; width:34%; height:5px; background:#f05b3e; box-shadow:0 12px #d9d5ca,0 24px #d9d5ca,0 42px #f05b3e; }
      .sticker { position:absolute; z-index:2; right:8%; top:9%; width:67px; height:67px; display:grid; place-items:center; border-radius:50%; color:#fff; background:#253f36; text-align:center; font-size:8px; font-weight:850; transform:rotate(11deg); }
      .poster-meta { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:11px 5.5%; border-top:1px solid var(--line); border-bottom:1px solid var(--line); color:var(--muted); font-size:8px; text-transform:uppercase; }
      .poster-meta strong { color:var(--ink); }
      .poster-work { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; padding:19px 5.5%; }
      .poster-card { min-height:128px; position:relative; overflow:hidden; display:flex; flex-direction:column; justify-content:space-between; padding:12px; border:1px solid var(--line); background:#e2ddd0; }
      .poster-card:nth-child(2){background:#d2e2d6}.poster-card:nth-child(3){background:#d9d9ec}
      .poster-card::after { content:""; position:absolute; width:100px; height:100px; right:-25px; top:21px; border:1px solid #24231d6b; border-radius:50%; box-shadow:0 0 0 12px #ffffff27,0 0 0 25px #ffffff18; }
      .poster-card small { position:relative; z-index:1; color:var(--muted); font-size:8px; font-weight:800; text-transform:uppercase; }
      .poster-card strong { position:relative; z-index:1; max-width:130px; font-size:14px; line-height:1; letter-spacing:-.05em; }
      .poster-footer { display:flex; justify-content:space-between; align-items:center; margin:0 5.5% 18px; padding:13px; color:white; background:#20221f; font-size:10px; }
      .poster-footer a { color:#f2d75e; }
      /* 04 Blueprint: architecture map turns the developer's process into the visual identity. */
      .blueprint { --paper:#102a42; --ink:#f3f3e9; --muted:#b2c5d1; --accent:#f2d36c; --hot-text:#142b41; --line:#ffffff38; }
      .blueprint .nav { border-bottom:1px solid #ffffff35; }
      .blueprint-board { position:relative; overflow:hidden; min-height:455px; padding:39px 6%; background-color:#12334e; background-image:linear-gradient(#ffffff0c 1px,transparent 1px),linear-gradient(90deg,#ffffff0c 1px,transparent 1px); background-size:26px 26px; }
      .blueprint-board::before { content:""; position:absolute; inset:0; pointer-events:none; background:radial-gradient(ellipse at 48% 47%,transparent 15%,#102a421a 75%); }
      .blueprint-title { position:relative; z-index:2; max-width:700px; }
      .blueprint-title h2 { margin:10px 0; font-size:clamp(45px,7vw,83px); line-height:.88; letter-spacing:-.08em; }
      .blueprint-title p { max-width:400px; color:var(--muted); font-size:11px; line-height:1.65; }
      .map { position:absolute; right:6%; top:32px; width:47%; height:360px; }
      .map svg { position:absolute; inset:0; width:100%; height:100%; overflow:visible; }
      .map path { fill:none; stroke:#f2d36c; stroke-width:1.2; stroke-dasharray:4 4; opacity:.8; }
      .map-node { position:absolute; z-index:1; min-width:83px; padding:8px 9px; border:1px solid #d7e6e97d; color:#f3f3e9; background:#183f5c; font-size:8px; box-shadow:0 7px 17px #061a2a60; }
      .map-node b { display:block; color:#f2d36c; font-size:8px; }.map-node small { display:block; margin-top:3px; color:#b2c5d1; font-size:7px; }
      .map-node.m1 { left:5%;top:10%; }.map-node.m2 { right:0;top:22%; }.map-node.m3 { left:16%;bottom:18%; }.map-node.m4 { right:7%;bottom:5%; }
      .map-core { position:absolute; z-index:2; left:49%; top:49%; display:grid; place-items:center; width:82px;height:82px; transform:translate(-50%,-50%); border:1px solid #f2d36c; border-radius:50%; color:#f2d36c; background:#12334e; font-size:10px;font-weight:900; }
      .blueprint-legend { position:absolute; z-index:2; left:6%; bottom:24px; display:flex; gap:15px; color:var(--muted); font-size:8px; }.blueprint-legend span::before { content:""; display:inline-block; width:6px;height:6px; margin-right:5px; border-radius:50%; background:var(--accent); }
      .blueprint-bottom { display:grid; grid-template-columns:1fr 1fr; gap:0; border-top:1px solid #ffffff35; }
      .blueprint-bottom article { padding:16px 6%; }.blueprint-bottom article+article { border-left:1px solid #ffffff35; }
      .blueprint-bottom h3 { margin:5px 0; font-size:14px; }.blueprint-bottom p { margin:0; color:var(--muted); font-size:9px; line-height:1.55; }
      @media(max-width:760px) {
        body { padding:16px 10px 30px; }.intro { display:block; }.intro p { margin-top:10px; }
        .tabs { grid-template-columns:repeat(2,1fr); }.tab { min-height:57px; padding:8px; }
        .frame,.demo { min-height:0; }.nav { height:49px; padding:0 5%; }.navlinks { gap:10px; }
        .orbit-stage { grid-template-columns:1fr; gap:5px; padding:35px 7% 22px; }.orbit-stage::before { width:360px;height:360px;right:-20%;top:67%; }.orbit-stage::after { width:250px;height:250px;right:-1%;top:67%; }.orbit h2 { max-width:440px; }.constellation { width:min(100%,350px); margin-top:-3px; }.core { width:100px;height:100px;font-size:26px; }.node { padding:7px;font-size:8px; }.orbit-bottom { flex-direction:column; gap:8px; }
        .desk-shell { padding:10px; }.desk-grid { grid-template-columns:1fr 1fr; }.desk-profile { grid-column:span 2; display:grid; grid-template-columns:55px 1fr; column-gap:10px; align-items:center; }.avatar-stamp { grid-row:span 3; width:50px;height:50px;margin:0; }.desk-profile p { margin:3px 0; }.desk-files { grid-column:span 2; }.file-card { min-height:105px; }.desk-widget { grid-column:span 2; }.app-window { grid-column:span 2; }.app-content { grid-template-columns:1fr; }.app-screenshot { min-height:95px; }.desk-dock { margin-bottom:4px; }
        .poster-top { grid-template-columns:1fr; padding:26px 5% 18px; }.poster-copy h2 { font-size:clamp(59px,17vw,98px); }.poster-image { min-height:245px; }.poster-work { grid-template-columns:1fr; }.poster-card { min-height:85px; }.poster-card::after { right:20px;top:-5px; }.poster-footer { gap:8px; font-size:8px; }
        .blueprint-board { min-height:620px; padding:32px 6%; }.map { top:250px;left:5%;right:auto;width:90%;height:330px; }.blueprint-legend { bottom:13px;left:6%; }.blueprint-bottom { grid-template-columns:1fr; }.blueprint-bottom article+article { border-left:0;border-top:1px solid #ffffff35; }
      }
      @media(prefers-reduced-motion:reduce) { *,*::before,*::after { animation-duration:.01ms!important;transition-duration:.01ms!important; } }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="intro"><div><div class="eyebrow">Creative portfolio directions</div><h1>Four visual ideas with a point of view.</h1></div><p>Each concept uses a different visual metaphor and page composition. Choose a tab to explore; product artwork is made from CSS mockups.</p></header>
      <div class="tabs" role="tablist" aria-label="Creative portfolio concepts">
        {concepts.map((concept,index)=><button class="tab" id={`tab-${concept.id}`} role="tab" aria-selected={index===0?'true':'false'} aria-controls={`demo-${concept.id}`} tabindex={index===0?'0':'-1'} data-concept={concept.id}><strong>{concept.number} / {concept.name}</strong><span>{concept.note}</span></button>)}
      </div>
      <div class="frame">
        <section class="demo orbit active" id="demo-orbit" role="tabpanel" aria-labelledby="tab-orbit" aria-hidden="false">
          <nav class="nav"><a class="brand" href="#">AABID / ENGINEER</a><div class="navlinks"><a href="#orbit-work">Work</a><a href="#orbit-contact">Contact</a></div></nav>
          <div class="orbit-stage"><div class="orbit-copy"><div class="eyebrow">Independent developer · Navi Mumbai</div><h2>Good work has gravity.</h2><p>I build web and mobile products that bring teams, tools, and people together. Explore the projects orbiting my work.</p><a class="cta hot" href="#orbit-work">Explore the constellation ↗</a></div><div class="constellation" aria-label="Orbit map connecting Aabid to portfolio projects"><div class="ring"></div><div class="ring r2"></div><div class="core">AS</div><div class="node n1">Commerce<small>Laravel · Vue</small></div><div class="node n2">Social<small>Flutter · Firebase</small></div><div class="node n3">Analytics<small>React · Node</small></div><div class="node n4">Healthcare<small>Vue · Laravel</small></div></div></div>
          <div class="orbit-bottom" id="orbit-work"><span><strong>7+ years</strong> making systems feel simple</span><span>Backend · Frontend · Mobile · Product thinking</span><a id="orbit-contact" href="mailto:shaikhaabidhussain@gmail.com">Have an idea? Let’s connect ↗</a></div>
        </section>

        <section class="demo desktop" id="demo-desktop" role="tabpanel" aria-labelledby="tab-desktop" aria-hidden="true">
          <nav class="nav"><a class="brand" href="#">AABID’S WORKSPACE</a><div class="navlinks"><a href="#desk-files">Projects</a><a href="mailto:shaikhaabidhussain@gmail.com">Contact ↗</a></div></nav>
          <div class="desk-shell"><div class="desk-top"><span>⌘ &nbsp; PORTFOLIO / HOME</span><span class="time">NAVI MUMBAI, IN &nbsp; · &nbsp; AVAILABLE FOR SELECT PROJECTS</span></div><div class="desk-grid">
