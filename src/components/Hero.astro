---
interface Props {
  name: string;
  role: string;
  location: string;
  bio: string;
}

const { name, role, location, bio } = Astro.props;
---

<section class="section min-h-[90vh] flex items-center relative overflow-hidden">
  <!-- Background Effects -->
  <div class="bg-mesh"></div>
  <div class="bg-grid"></div>
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
  
  <div class="container relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left Column - Hero Content -->
      <div class="reveal text-center lg:text-left">
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 glass-strong mb-6 max-w-fit mx-auto lg:mx-0 reveal-delay-1" style="transition-delay: 100ms;">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="label text-cyan-400">Available for projects</span>
        </div>
        
        <!-- Greeting -->
        <p class="label text-cyan-400 mb-4 reveal-delay-2" style="transition-delay: 200ms;">Hello, I'm</p>
        
        <!-- Name -->
        <h1 class="display-xl mb-6 reveal-delay-2 gradient-text" style="transition-delay: 200ms;">
          {name}
        </h1>
        
        <!-- Role & Location -->
        <div class="flex flex-col sm:flex-row items-center sm:items-center lg:justify-start gap-3 mb-6 reveal-delay-3" style="transition-delay: 300ms;">
          <div class="flex items-center gap-2 text-slate-400 body">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>{location}</span>
          </div>
          <div class="flex items-center gap-2 text-slate-400 body">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>6+ years experience</span>
          </div>
        </div>
        
        <!-- Bio -->
        <p class="body-lg text-slate-300 max-w-xl mb-8 reveal-delay-4" style="transition-delay: 400ms;">
          {bio}
        </p>
        
        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 reveal-delay-5" style="transition-delay: 500ms;">
          <a href="#projects" class="btn btn-primary group">
            View Projects
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
          <a href="#contact" class="btn btn-glass group">
            Let's Connect
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
          </a>
          <a href="/portfollio/Aabid-Hussain-Shaikh-Resume.pdf" download class="btn btn-ghost group">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Resume
          </a>
        </div>
        
        <!-- Tech Stack Preview -->
        <div class="mt-10 flex flex-wrap justify-center lg:justify-start gap-2 reveal-delay-5" style="transition-delay: 500ms;" role="list" aria-label="Core technologies">
          <span class="chip chip-primary" role="listitem">Laravel</span>
          <span class="chip chip-accent" role="listitem">Vue.js</span>
          <span class="chip chip-accent" role="listitem">Flutter</span>
          <span class="chip" style="border-color: var(--accent-violet); color: var(--accent-violet);" role="listitem">React</span>
          <span class="chip" style="border-color: var(--accent-amber); color: var(--accent-amber);" role="listitem">Node.js</span>
        </div>
      </div>
      
      <!-- Right Column - Visual Card -->
      <div class="relative reveal float" style="transition-delay: 200ms;">
        <!-- Main Glass Card -->
        <div class="glass-strong p-6 lg:p-8 max-w-md mx-auto lg:mx-0">
          <div class="flex items-center justify-between mb-6">
            <span class="label text-cyan-400">developer@portfolio</span>
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
          </div>
          
          <pre class="font-mono text-sm text-slate-300 leading-relaxed overflow-x-auto"><code>{`const developer = {
  name: "${name}",
  role: "${role}",
  location: "${location}",
  experience: "6+ years",
  
  stack: {
    backend: ["Laravel", "Node.js", "PHP"],
    frontend: ["Vue.js", "React", "Nuxt", "Tailwind"],
    mobile: ["Flutter", "Dart", "Firebase"],
    database: ["MySQL", "MongoDB", "Redis"],
    devops: ["Docker", "Linux", "AWS", "CI/CD"]
  },
  
  currently: "Building scalable systems",
  available: true
};

console.log("Ready to build something amazing?");`}</code></pre>
        </div>
        
        <!-- Floating Stats Cards -->
        <div class="absolute -bottom-6 -left-6 lg:-left-8 reveal-delay-3 float" style="transition-delay: 300ms; animation-delay: 1s;">
          <div class="glass-strong p-4 min-w-[160px]">
            <div class="stat-value">50+</div>
            <div class="label text-slate-500 mt-1">Projects Delivered</div>
          </div>
        </div>
        <div class="absolute -bottom-6 -right-6 lg:-right-8 reveal-delay-4 float" style="transition-delay: 400ms; animation-delay: 1.5s;">
          <div class="glass-strong p-4 min-w-[160px]">
            <div class="stat-value">30+</div>
            <div class="label text-slate-500 mt-1">Happy Clients</div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 reveal" style="transition-delay: 800ms;">
      <a href="#about" class="flex flex-col items-center gap-2 text-slate-500 hover:text-cyan-400 transition-colors" aria-label="Scroll to about section">
        <span class="label">Scroll to explore</span>
        <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
      </a>
    </div>
  </div>
</section>