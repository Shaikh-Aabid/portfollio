---
interface Props {
  email: string;
  github: string;
  linkedin: string;
}

const { email, github, linkedin } = Astro.props;
---

<section id="contact" class="section">
  <div class="container">
    <header class="text-center max-w-2xl mx-auto mb-16 reveal">
      <span class="badge badge-accent mb-4">Get In Touch</span>
      <h2 class="display-lg mb-4">Let's Build <span class="gradient-text">Together</span></h2>
      <p class="body-lg text-slate-400 max-w-xl mx-auto">
        Have a project in mind? I'm always open to discussing new opportunities and interesting challenges.
      </p>
    </header>
    
    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Contact Info Cards -->
      <div class="lg:col-span-1 reveal stagger-children">
        <div class="glass-strong p-6 hover:border-cyan-400/50">
          <div class="w-14 h-14 rounded-xl glass-strong flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.07 8.75L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">Email</h3>
          <p class="text-slate-400 body-sm mb-4">Preferred method for project inquiries</p>
          <a href={`mailto:${email}`} class="btn btn-glass w-full justify-center group">
            Send Email
            <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
        
        <div class="glass-strong p-6 mt-4 hover:border-emerald-400/50">
          <div class="w-14 h-14 rounded-xl glass-strong flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.519-.62-.325-1.427-.354-2.26-.287-.89-.003-.684.51-.684.51.531 2.13 2.623 2.13 2.623 1.472 2.15 1.473 3.884 1.473 3.884 1.42 2.166 2.676 1.654 3.334 1.472.1-.484.316-.96.682-1.477-2.44-1.779-4.104-3.773-3.523-6.839.438-.664.5-1.538.5-1.883 0-3.693-.027-.666-.027-.668 0-1.35-1.314-.774-2.866-1.206-2.866-5.396-.636-.595-1.55-.854-1.55-2.548 0-1.299.934-2.312 2.352-2.498.715-.079 1.23-.438 1.23-1.063 0-.891-.316-1.624-.316-1.624 1.385-.161 2.378-1.93 2.159-3.944.754-.1.567-.414.567-.414M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.519-.62-.325-1.427-.354-2.26-.287-.89-.003-.684.51-.684.51.531 2.13 2.623 2.13 2.623 1.472 2.15 1.473 3.884 1.473 3.884 1.42 2.166 2.676 1.654 3.334 1.472.1-.484.316-.96.682-1.477-2.44-1.779-4.104-3.773-3.523-6.839.438-.664.5-1.538.5-1.883 0-3.693-.027-.666-.027-.668 0-1.35-1.314-.774-2.866-1.206-2.866-5.396-.636-.595-1.55-.854-1.55-2.548 0-1.299.934-2.312 2.352-2.498.715-.079 1.23-.438 1.23-.714C12 9.2 12.6 8.5 13 7.3c0-.1-.2-.4-.2-.949V2H2" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">GitHub</h3>
          <p class="text-slate-400 body-sm mb-4">Open source projects & contributions</p>
          <a href="https://github.com/Shaikh-Aabid" target="_blank" rel="noopener noreferrer" class="btn btn-glass w-full justify-center group">
            View Profile
            <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.519-.62-.325-1.427-.354-2.26-.287-.89-.003-.684.51-.684.51.531 2.13 2.623 2.13 2.623 1.472 2.15 1.473 3.884 1.473 3.884 1.42 2.166 2.676 1.654 3.334 1.472.1-.484.316-.96.682-1.477-2.44-1.779-4.104-3.773-3.523-6.839.438-.664.5-1.538.5-1.883 0-3.693-.027-.666-.027-.668 0-1.35-1.314-.774-2.866-1.206-2.866-5.396-.636-.595-1.55-.854-1.55-2.548 0-1.299.934-2.312 2.352-2.498.715-.079 1.23-.438 1.23-1.063 0-.891-.316-1.624-.316-1.624 1.385-.161 2.378-1.93 2.159-3.944.754-.1.567-.414.567-.414M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.519-.62-.325-1.427-.354-2.26-.287-.89-.003-.684.51-.684.51.531 2.13 2.623 2.13 2.623 1.472 2.15 1.473 3.884 1.473 3.884 1.42 2.166 2.676 1.654 3.334 1.472.1-.484.316-.96.682-1.477-2.44-1.779-4.104-3.773-3.523-6.839.438-.664.5-1.538.5-1.883 0-3.693-.027-.666-.027-.668 0-1.35-1.314-.774-2.866-1.206-2.866-5.396-.636-.595-1.55-.854-1.55-2.548 0-1.299.934-2.312 2.352-2.498.715-.079 1.23-.438 1.23-.714C12 9.2 12.6 8.5 13 7.3c0-.1-.2-.4-.2-.949V2H2" clip-rule="evenodd"/></svg>
            View Profile
          </a>
        </div>
        
        <div class="glass-strong p-6 mt-4 hover:border-violet-400/50">
          <div class="w-14 h-14 rounded-xl glass-strong flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-violet-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-2.937-1.887-2.937-1.887 0-2.166 1.737-2.166 2.937v5.517H9.431V9.75h5.414v1.404c.516-.986 1.504-2.518 3.459-2.518 4.509 0 8.546 2.592 8.546 8.233V20.452zM5.337 7.433a2.26 2.26 0 01-2.262-2.259c0-1.264 1.02-2.285 2.262-2.285s2.262 1.021 2.262 2.285a2.26 2.26 0 01-2.262 2.259zm1.372 13.019H3.964V9.75H7.709v10.702z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">LinkedIn</h3>
          <p class="text-slate-400 body-sm mb-4">Professional network & updates</p>
          <a href="https://www.linkedin.com/in/aabid-hussain-shaikh/" target="_blank" rel="noopener noreferrer" class="btn btn-glass w-full justify-center group">
            Connect
            <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-2.937-1.887-2.937-1.887 0-2.166 1.737-2.166 2.937v5.517H9.431V9.75h5.414v1.404c.516-.986 1.504-2.518 3.459-2.518 4.509 0 8.546 2.592 8.546 8.233V20.452zM5.337 7.433a2.26 2.26 0 01-2.262-2.259c0-1.264 1.02-2.285 2.262-2.285s2.262 1.021 2.262 2.285a2.26 2.26 0 01-2.262 2.259zm1.372 13.019H3.964V9.75H7.709v10.702z"/></svg>
            Connect
          </a>
        </div>
      </div>
      
      <!-- Contact Form -->
      <div class="lg:col-span-2 reveal">
        <form class="glass-strong p-8" id="contact-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_KEY" />
          <input type="hidden" name="subject" value="Portfolio Contact Form" />
          <input type="hidden" name="redirect" value="https://shaikh-aabid.github.io/portfollio/#contact" />
          
          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <div class="form-group">
              <label for="name" class="form-label">Name</label>
              <input type="text" id="name" name="name" class="form-input" placeholder="Your name" required />
            </div>
            <div class="form-group">
              <label for="email" class="form-label">Email</label>
              <input type="email" id="email" name="email" class="form-input" placeholder="your@email.com" required />
            </div>
          </div>
          
          <div class="form-group mb-6">
            <label for="project-type" class="form-label">Project Type</label>
            <select id="project-type" name="project_type" class="form-input">
              <option value="">Select project type</option>
              <option value="web">Web Application</option>
              <option value="mobile">Mobile App (Flutter)</option>
              <option value="api">API / Backend</option>
              <option value="ecommerce">E-Commerce</option>
              <option value="other">Other</option>
            </select>
          </div>
          
          <div class="form-group mb-6">
            <label for="budget" class="form-label">Estimated Budget</label>
            <select id="budget" name="budget" class="form-input">
              <option value="">Select budget range</option>
              <option value="under-5k">Under $5,000</option>
              <option value="5k-15k">$5,000 - $15,000</option>
              <option value="15k-50k">$15,000 - $50,000</option>
              <option value="50k-plus">$50,000+</option>
              <option value="not-sure">Not sure yet</option>
            </select>
          </div>
          
          <div class="form-group mb-6">
            <label for="message" class="form-label">Project Details</label>
            <textarea id="message" name="message" rows="5" class="form-input" placeholder="Tell me about your project, goals, timeline, and any specific requirements..." required></textarea>
          </div>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <button type="submit" class="btn btn-primary group w-full sm:w-auto" id="submit-btn">
              <span class="btn-text">Send Message</span>
              <span class="btn-loading hidden">
                <svg class="animate-spin w-5 h-5 mr-2" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                Sending...
              </span>
            </button>
            <button type="reset" class="btn btn-glass w-full sm:w-auto">Clear</button>
          </div>
          
          <p class="text-center text-slate-500 text-sm mt-4">
            By submitting this form, you agree to our <a href="#" class="text-cyan-400 hover:underline">Privacy Policy</a>
          </p>
        </form>
        
        <!-- Success/Error Toast Container -->
        <div id="form-toast" class="fixed bottom-6 right-6 z-50 hidden" role="alert"></div>
      </div>
    </div>
  </div>
</section>

<script>
  // Form handling with Web3Forms
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = submitBtn.querySelector('.btn-text');
    const btnLoading = submitBtn.querySelector('.btn-loading');
    const toastContainer = document.getElementById('form-toast');
    
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // UI loading state
      submitBtn.disabled = true;
      btnText.classList.add('hidden');
      btnLoading.classList.remove('hidden');
      
      const formData = new FormData(form);
      
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        });
        
        if (response.ok) {
          showToast('Message sent successfully! I\'ll get back to you within 24 hours.', 'success');
          form.reset();
        } else {
          throw new Error('Form submission failed');
        }
      } catch (error) {
        showToast('Something went wrong. Please try again or email directly.', 'error');
      } finally {
        submitBtn.disabled = false;
        btnText.classList.remove('hidden');
        btnLoading.classList.add('hidden');
      }
    });
    
    function showToast(message, type) {
      const toast = document.createElement('div');
      toast.className = `glass-strong p-4 rounded-xl min-w-[300px] max-w-md shadow-2xl animate-slide-up ${
        type === 'success' ? 'border-emerald-400/30' : 'border-red-400/30'
      }`;
      toast.innerHTML = `
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 ${ 
            type === 'success' ? 'bg-emerald-400/20 text-emerald-400' : 'bg-red-400/20 text-red-400'
          }">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              ${type === 'success' 
                ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>'
                : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>'
              }
            </svg>
          </div>
          <p class="text-sm text-slate-200">${message}</p>
        </div>
      `;
      
      toastContainer.appendChild(toast);
      toastContainer.classList.remove('hidden');
      
      setTimeout(() => {
        toast.style.animation = 'slide-up 0.3s ease-in-out reverse';
        setTimeout(() => toast.remove(), 300);
        if (toastContainer.children.length === 0) {
          toastContainer.classList.add('hidden');
        }
      }, 5000);
    }
    
    // Floating label animation enhancement
    document.querySelectorAll('.form-input').forEach(input => {
      input.addEventListener('focus', () => {
        input.parentElement.classList.add('focused');
      });
      
      input.addEventListener('blur', () => {
        if (!input.value) {
          input.parentElement.classList.remove('focused');
        }
      });
      
      // Check initial value
      if (input.value) {
        input.parentElement.classList.add('focused');
      }
    });
  });
</script>

<style>
  /* Form toast animation */
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-slide-up {
    animation: slide-up 0.3s ease-out;
  }
  
  /* Form focus states */
  .form-group.focused .form-label {
    @apply -translate-y-7 scale-85 text-cyan-400;
  }
  
  /* Submit button states */
  #submit-btn {
    @apply transition-all duration-200;
  }
  
  #submit-btn:disabled {
    @apply opacity-70 cursor-not-allowed;
  }
  
  .btn-loading {
    @apply inline-flex items-center;
  }
  
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  
  .animate-spin {
    animation: spin 1s linear infinite;
  }
  
  /* Form validation states */
  .form-input:invalid:not(:placeholder-shown) {
    @apply border-red-400/50;
  }
  
  .form-input:valid:not(:placeholder-shown) {
    @apply border-emerald-400/30;
  }
  
  /* Smooth transitions for all form elements */
  .form-input,
  .form-label,
  .btn {
    @apply transition-all duration-200 ease-out;
  }
  
  /* Toast animation */
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  
  @keyframes fade-out {
    from { opacity: 1; transform: translateY(0) scale(1); }
    to { opacity: 0; transform: translateY(-10px) scale(0.95); }
  }
</style>