---
interface Props {
  skills: Record<string, string>;
}
const { skills } = Astro.props;

// Group skills by category
const categories = {
  "Backend & API": ["Laravel / PHP", "Node.js / Express", "SQL / NoSQL", "Docker / DevOps"],
  "Frontend": ["Vue.js / Nuxt", "React / Next.js", "TypeScript", "Tailwind CSS"],
  "Mobile": ["Flutter / Dart", "Firebase", "State Management"],
  "Architecture & Tools": ["System Design", "REST / GraphQL", "Testing", "CI/CD"],
};

// Helper functions
function getCategoryColor(category: string): string {
  const colors: Record<string, string> = {
    'Backend & API': '#06b6d4',
    'Frontend': '#10b981',
    'Mobile': '#8b5cf6',
    'Architecture & Tools': '#f59e0b'
  };
  return colors[category] || '#06b6d4';
}

function getCategoryIcon(category: string): string {
  const icons: Record<string, string> = {
    'Backend & API': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path></svg>`,
    'Frontend': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 16h.01M18 7h.01M18 15h.01"></path></svg>`,
    'Mobile': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>`,
    'Architecture & Tools': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l4 4 4-4"></path></svg>`,
  };
  return icons[category] || icons['Backend & API'];
}
---

<section id="skills" class="section">
  <div class="container">
    <header class="text-center mb-16 reveal">
      <span class="badge badge-accent mb-4">Technical Expertise</span>
      <h2 class="display-lg mb-4">Technical <span class="gradient-text">Stack</span></h2>
      <p class="body-lg text-slate-400 max-w-2xl mx-auto">
        Deep expertise across the full stack — from database design to mobile deployment.
        Hover each skill to see proficiency level.
      </p>
    </header>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 stagger-children">
      {Object.entries(categories).map(([category, skillNames]) => (
        <div class="skill-card reveal">
          <div class="skill-icon" style="--icon-color: {getCategoryColor(category)}">
            {getCategoryIcon(category)}
          </div>
          <div class="flex flex-col gap-2">
            <h4 class="font-semibold text-slate-100">{category}</h4>
            <p class="text-slate-500 text-sm">{skillNames.length} Technologies</p>
          </div>
          
          <div class="flex flex-wrap gap-2 mt-2">
            {skillNames.map(skill => {
              const years = skills[skill] || "0";
              const proficiency = Math.min(parseInt(years) * 15, 100);
              return (
                <div class="skill-chip-group relative group">
                  <span class="chip chip-accent" style="--chip-color: {getCategoryColor(category)}">
                    {skill}
                    <span class="ml-2 opacity-70">{years}</span>
                  </span>
                  <div class="skill-progress-tooltip absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-40 opacity-0 invisible group-hover:visible group-hover:opacity-100 transition-all duration-200">
                    <div class="glass-strong p-3 rounded-lg text-center">
                      <div class="h-1.5 bg-slate-700 rounded-full overflow-hidden mb-1">
                        <div class="h-full bg-gradient-to-r from-cyan-400 to-emerald-400 rounded-full transition-all duration-500" style="width: {proficiency}%"></div>
                      </div>
                      <p class="body-sm text-slate-300">Proficiency: <span class="text-cyan-400 font-semibold">{proficiency}%</span></p>
                    </div>
                    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1 w-2 h-2 bg-slate-700 rotate-45"></div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
    
    <!-- Proficiency Legend -->
    <div class="mt-16 reveal reveal-delay-4">
      <h4 class="label text-center mb-6">Proficiency Scale</h4>
      <div class="flex flex-wrap justify-center gap-4">
        <div class="glass p-4 min-w-[200px]">
          <div class="flex items-center justify-between mb-2">
            <span class="text-slate-400 text-sm">Beginner</span>
            <span class="text-cyan-400 font-mono font-semibold">0-30%</span>
          </div>
          <div class="h-1.5 bg-slate-700 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-slate-500 to-cyan-500 rounded-full" style="width: 25%"></div>
          </div>
        </div>
        <div class="glass p-4 min-w-[200px]">
          <div class="flex items-center justify-between mb-2">
            <span class="text-slate-400 text-sm">Intermediate</span>
            <span class="text-emerald-400 font-mono font-semibold">31-60%</span>
          </div>
          <div class="h-1.5 bg-slate-700 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-emerald-500 to-cyan-400 rounded-full" style="width: 55%"></div>
          </div>
        </div>
        <div class="glass p-4 min-w-[200px]">
          <div class="flex items-center justify-between mb-2">
            <span class="text-slate-400 text-sm">Advanced</span>
            <span class="text-violet-400 font-mono font-semibold">61-85%</span>
          </div>
          <div class="h-1.5 bg-slate-700 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-violet-500 to-emerald-400 rounded-full" style="width: 75%"></div>
          </div>
        </div>
        <div class="glass p-4 min-w-[200px]">
          <div class="flex items-center justify-between mb-2">
            <span class="text-slate-400 text-sm">Expert</span>
            <span class="text-amber-400 font-mono font-semibold">86-100%</span>
          </div>
          <div class="h-1.5 bg-slate-700 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-amber-400 to-violet-500 rounded-full" style="width: 95%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Interactive hover effects
  document.addEventListener('DOMContentLoaded', () => {
    const skillGroups = document.querySelectorAll('.skill-chip-group');
    
    skillGroups.forEach(group => {
      group.addEventListener('mouseenter', () => {
        group.style.transform = 'translateY(-4px)';
      });
      group.addEventListener('mouseleave', () => {
        group.style.transform = 'translateY(0)';
      });
    });
  });
  
  function getCategoryColor(category) {
    const colors = {
      'Backend & API': '#06b6d4',
      'Frontend': '#10b981',
      'Mobile': '#8b5cf6',
      'Architecture & Tools': '#f59e0b'
    };
    return colors[category] || '#06b6d4';
  }
  
  function getCategoryIcon(category) {
    const icons = {
      'Backend & API': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path></svg>`,
      'Frontend': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 16h.01M18 7h.01M18 15h.01"></path></svg>`,
      'Mobile': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>`,
      'Architecture & Tools': `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l4 4 4-4"></path></svg>`,
    };
    return icons[category] || icons['Backend & API'];
  }
</script>

<style>
  .skill-chip-group {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .skill-chip-group .chip {
    position: relative;
    overflow: visible;
  }
  
  .skill-chip-group .chip::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    background: var(--chip-color);
    opacity: 0;
    filter: blur(8px);
    transition: opacity 0.3s;
    z-index: -1;
  }
  
  .skill-chip-group:hover .chip::before {
    opacity: 0.4;
  }
  
  .skill-progress-tooltip {
    z-index: 10;
  }
  
  .skill-card {
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .skill-card:hover {
    transform: translateY(-8px);
    border-color: var(--border-glass);
  }
  
  .skill-card:hover .skill-icon {
    transform: scale(1.15) rotate(3deg);
  }
</style>