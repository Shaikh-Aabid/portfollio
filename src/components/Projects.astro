---
interface Props {
  featuredProjects: Array<{
    name: string;
    description: string;
    stack: string[];
    type: string;
    highlights: string[];
    screenshot: string;
  }>;
}

const { featuredProjects } = Astro.props;

// Filter projects by type
const webProjects = featuredProjects.filter(p => p.type === 'web');
const mobileProjects = featuredProjects.filter(p => p.type === 'mobile');
---

<section id="projects" class="section">
  <div class="container">
    <!-- Section Header -->
    <header class="text-center max-w-2xl mx-auto mb-16 reveal">
      <span class="label text-cyan-400 mb-4">Featured Work</span>
      <h2 class="display-lg mb-4">Selected Projects</h2>
      <p class="body-lg text-slate-400 max-w-xl mx-auto">
        A curated selection of production applications across web and mobile platforms.
      </p>
    </header>
    
    <!-- Filter Tabs -->
    <div class="flex flex-wrap justify-center gap-3 mb-12 reveal" style="transition-delay: 200ms;">
      <button class="filter-tab active" data-filter="all" aria-pressed="true">All Projects</button>
      <button class="filter-tab" data-filter="web" aria-pressed="false">Web Apps</button>
      <button class="filter-tab" data-filter="mobile" aria-pressed="false">Mobile Apps</button>
    </div>
    
    <!-- Projects Grid -->
    <div class="projects-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal stagger-children">
      {featuredProjects.map((project, index) => (
        <article 
          class="project-card group"
          data-type={project.type}
          data-index={index}
          style={`transition-delay: ${index * 100}ms;`}
        >
          <!-- Image with overlay -->
          <div class="relative aspect-[16/10] overflow-hidden rounded-2xl">
            <img 
              src={project.screenshot} 
              alt={`Screenshot of ${project.name}`}
              class="project-image w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-900/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            
            <!-- Project Content Overlay -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
              <div class="space-y-3">
                <div class="flex items-center gap-2">
                  <span class={`badge ${project.type === 'web' ? 'badge-web' : 'badge-mobile'}`}>
                    {project.type === 'web' ? 'Web App' : 'Mobile App'}
                  </span>
                </div>
                
                <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors">
                  {project.name}
                </h3>
                
                <p class="text-slate-300 line-clamp-2 body-sm">
                  {project.description}
                </p>
                
                <!-- Tech Stack -->
                <div class="flex flex-wrap gap-1.5">
                  {project.stack.slice(0, 4).map(tech => (
                    <span class="chip chip-accent text-xs">{tech}</span>
                  ))}
                  {project.stack.length > 4 && (
                    <span class="chip text-xs text-slate-500 border-slate-700">
                      +{project.stack.length - 4} more
                    </span>
                  )}
                </div>
                
                <!-- Highlights Preview -->
                <div class="space-y-1.5 pt-2 border-t border-slate-800">
                  {project.highlights.slice(0, 2).map(highlight => (
                    <div class="flex items-start gap-2 text-slate-300 text-sm">
                      <svg class="w-4 h-4 flex-shrink-0 text-cyan-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      <span class="line-clamp-1">{highlight}</span>
                    </div>
                  ))}
                  {project.highlights.length > 2 && (
                    <div class="text-cyan-400 text-sm font-medium">
                      +{project.highlights.length - 2} more highlights
                    </div>
                  )}
                </div>
                
                <!-- Action Buttons -->
                <div class="flex gap-3 pt-3">
                  <a href={project.github || '#'} target="_blank" rel="noopener noreferrer" 
                     class="btn btn-glass text-sm group flex-1 justify-center">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.519-.62-.325-1.427-.354-2.26-.287-.89-.003-.684.51-.684.51.531 2.13 2.623 2.13 2.623 1.472 2.15 1.473 3.884 1.473 3.884 1.42 2.166 2.676 1.654 3.334 1.472.1-.484.316-.96.682-1.477-2.44-1.779-4.104-3.773-3.523-6.839.438-.664.5-1.538.5-1.883 0-3.693-.027-.666-.027-.668 0-1.35-1.314-.774-2.866-1.206-2.866-5.396-.636-.595-1.55-.854-1.55-2.548 0-1.299.934-2.312 2.352-2.498.715-.079 1.23-.438 1.23-1.063 0-.891-.316-1.624-.316-1.624 1.385-.161 2.378-1.93 2.159-3.944.754-.1.567-.414.567-.414M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.519-.62-.325-1.427-.354-2.26-.287-.89-.003-.684.51-.684.51.531 2.13 2.623 2.13 2.623 1.472 2.15 1.473 3.884 1.473 3.884 1.42 2.166 2.676 1.654 3.334 1.472.1-.484.316-.96.682-1.477-2.44-1.779-4.104-3.773-3.523-6.839.438-.664.5-1.538.5-1.883 0-3.693-.027-.666-.027-.668 0-1.35-1.314-.774-2.866-1.206-2.866-5.396-.636-.595-1.55-.854-1.55-2.548 0-1.299.934-2.312 2.352-2.498.715-.079 1.23-.438 1.23-1.063 0-.891-.316-1.624-.316-1.624 1.385-.161 2.378-1.93 2.159-3.944.754-.1.567-.414.567-.414M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.519-.62-.325-1.427-.354-2.26-.287-.89-.003-.684.51-.684.51.531 2.13 2.623 2.13 2.623 1.472 2.15 1.473 3.884 1.473 3.884 1.42 2.166 2.676 1.654 3.334 1.472.1-.484.316-.96.682-1.477-2.44-1.779-4.104-3.773-3.523-6.839.438-.664.5-1.538.5-1.883 0-3.693-.027-.666-.027-.668 0-1.35-1.314-.774-2.866-1.206-2.866-5.396-.636-.595-1.55-.854-1.55-2.548 0-1.299.934-2.312 2.352-2.498.715-.079 1.23-.438 1.23-.714C12 9.2 12.6 8.5 13 7.3c0-.1-.2-.4-.2-.949V2H2"/></svg>
                    Code
                  </a>
                  <a href={project.demo || '#'} target="_blank" rel="noopener noreferrer" 
                     class="btn btn-primary text-sm flex-1 justify-center">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                    Live Demo
                  </a>
                </div>
              </div>
            </div>
            
            <!-- Type Badge (always visible) -->
            <div class="absolute top-4 right-4">
              <span class={`badge ${project.type === 'web' ? 'badge-web' : 'badge-mobile'}`}>
                {project.type === 'web' ? 'Web' : 'Mobile'}
              </span>
            </div>
          </div>
          
          <!-- Card Footer (always visible) -->
          <div class="p-5 pt-0 space-y-3">
            <div class="flex items-start gap-3">
              <div class="w-12 h-12 rounded-xl glass-strong flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={project.type === 'web' ? "M9 7h6m0 10v-3m-3 3h.01M9 16h.01M18 7h.01M18 15h.01" : "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"}></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-white">{project.name}</h4>
                <p class="text-slate-500 text-sm body">{project.type === 'web' ? 'Web Application' : 'Mobile Application'}</p>
              </div>
            </div>
            
            <div class="flex flex-wrap gap-1.5">
              {project.stack.slice(0, 3).map(tech => (
                <span class="chip text-xs">{tech}</span>
              ))}
              {project.stack.length > 3 && (
                <span class="chip text-xs text-slate-500 border-slate-700">
                  +{project.stack.length - 3}
                </span>
              )}
            </div>
          </div>
        </article>
      ))}
</div>
  
  <!-- Load More / View All -->
  <div class="text-center mt-12 reveal" style="transition-delay: 400ms;">
    <a href="https://github.com/Shaikh-Aabid" target="_blank" rel="noopener noreferrer" class="btn btn-glass group">
      View All on GitHub
      <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.519-.62-.325-1.427-.354-2.26-.287-.89-.003-.684.51-.684.51.531 2.13 2.623 2.13 2.623 1.472 2.15 1.473 3.884 1.473 3.884 1.42 2.166 2.676 1.654 3.334 1.472.1-.484.316-.96.682-1.477-2.44-1.779-4.104-3.773-3.523-6.839.438-.664.5-1.538.5-1.883 0-3.693-.027-.666-.027-.668 0-1.35-1.314-.774-2.866-1.206-2.866-5.396-.636-.595-1.55-.854-1.55-2.548 0-1.299.934-2.312 2.352-2.498.715-.079 1.23-.438 1.23-1.063 0-.891-.316-1.624-.316-1.624 1.385-.161 2.378-1.93 2.159-3.944.754-.1.567-.414.567-.414M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.519-.62-.325-1.427-.354-2.26-.287-.89-.003-.684.51-.684.51.531 2.13 2.623 2.13 2.623 1.472 2.15 1.473 3.884 1.473 3.884 1.42 2.166 2.676 1.654 3.334 1.472.1-.484.316-.96.682-1.477-2.44-1.779-4.104-3.773-3.523-6.839.438-.664.5-1.538.5-1.883 0-3.693-.027-.666-.027-.668 0-1.35-1.314-.774-2.866-1.206-2.866-5.396-.636-.595-1.55-.854-1.55-2.548 0-1.299.934-2.312 2.352-2.498.715-.079 1.23-.438 1.23-.714C12 9.2 12.6 8.5 13 7.3c0-.1-.2-.4-.2-.949V2H2"/></svg>
      View All on GitHub
    </a>
  </div>
</section>

<script is:inline>
  // Filter functionality - runs on client only
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll('.project-card');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.dataset.filter;
        
        // Update active tab
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-pressed', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-pressed', 'true');
        
        // Filter cards with animation
        cards.forEach((card, index) => {
          const type = card.dataset.type;
          const shouldShow = filter === 'all' || type === filter;
          
          if (shouldShow) {
            card.style.display = 'block';
            setTimeout(() => {
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            }, index * 50);
          } else {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            setTimeout(() => {
              card.style.display = 'none';
            }, 300);
          }
        });
      });
    });
    
    // Enhanced hover effects for project cards
    const cards = document.querySelectorAll('.project-card');
    cards.forEach(card => {
      const image = card.querySelector('.project-image');
      if (image) {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          const rotateX = (y - centerY) / 20;
          const rotateY = (centerX - x) / 20;
          
          image.style.transform = `scale(1.05) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });
        
        card.addEventListener('mouseleave', () => {
          image.style.transform = 'scale(1) rotateX(0) rotateY(0)';
        });
      }
    });
    
    // Intersection Observer for project cards
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    
    document.querySelectorAll('.project-card').forEach(card => {
      observer.observe(card);
    });
  });
</script>

<style>
  .filter-tab {
    @apply px-4 py-2 glass-strong label cursor-pointer transition-all duration-300;
    @apply hover:border-cyan-400/50 hover:text-cyan-400;
  }
  
  .filter-tab.active {
    @apply border-cyan-400 text-cyan-400 bg-cyan-400/10;
  }
  
  .projects-grid {
    @apply gap-6;
  }
  
  .project-card {
    @apply relative rounded-2xl overflow-hidden glass-strong flex flex-col;
    @apply opacity-0 transform translate-y-8 transition-all duration-500 ease-out;
  }
  
  .project-card.visible {
    @apply opacity-100 translate-y-0;
  }
  
  .project-image {
    @apply transition-transform duration-700 ease-out;
    transform-origin: center;
  }
  
  /* 3D tilt effect on hover */
  .project-card:hover .project-image {
    @apply scale-105;
  }
  
  /* Filter animation */
  .project-card {
    @apply transition-all duration-300 ease-out;
  }
  
  .project-card[style*="display: none"] {
    @apply opacity-0 pointer-events-none;
  }
  
  /* Filter tab styles */
  .filter-tab {
    @apply relative overflow-hidden;
  }
  
  .filter-tab::before {
    @apply absolute inset-0 bg-gradient-to-r from-cyan-400 to-emerald-400 opacity-0 transition-opacity;
    content: '';
    z-index: -1;
  }
  
  .filter-tab.active::before {
    @apply opacity-20;
  }
  
  .filter-tab:hover:not(.active) {
    @apply border-cyan-400/50 text-cyan-400;
  }
  
  /* Stagger animation delays */
  .stagger-children > * {
    @apply opacity-0 translate-y-6;
    @apply transition-all duration-500 ease-out;
  }
  
  .stagger-children.visible > * {
    @apply opacity-100 translate-y-0;
  }
  
  .stagger-children > *:nth-child(1) { transition-delay: 50ms; }
  .stagger-children > *:nth-child(2) { transition-delay: 100ms; }
  .stagger-children > *:nth-child(3) { transition-delay: 150ms; }
  .stagger-children > *:nth-child(4) { transition-delay: 200ms; }
  .stagger-children > *:nth-child(5) { transition-delay: 250ms; }
  .stagger-children > *:nth-child(6) { transition-delay: 300ms; }
  
  /* Badge variants */
  .badge-web {
    @apply bg-cyan-400/20 text-cyan-400 border-cyan-400/30;
  }
  
  .badge-mobile {
    @apply bg-emerald-400/20 text-emerald-400 border-emerald-400/30;
  }
  
  /* Chip hover effect */
  .chip {
    @apply transition-all duration-200;
  }
  
  .chip:hover {
    @apply scale-105;
  }
  
  .chip-accent:hover {
    @apply border-cyan-400 text-cyan-400;
  }
  
  /* Project card footer */
  .project-card > div:last-child {
    @apply border-t border-slate-800/50 pt-4;
  }
  
  /* Focus states for accessibility */
  .filter-tab:focus-visible,
  .project-card a:focus-visible {
    @apply outline-none ring-2 ring-cyan-400 ring-offset-2 ring-offset-slate-950;
  }
</style>